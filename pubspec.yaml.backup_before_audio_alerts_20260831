name: nexus_fx_scanner_flutter_twin
description: Pixel-matched Flutter twin of the NEXUS FX Scanner Pro concept dashboard.
publish_to: 'none'
version: 1.0.0+1

environment:
  sdk: '>=3.3.0 <4.0.0'

dependencies:
  flutter:
    sdk: flutter
  cupertino_icons: ^1.0.8
  http: ^1.6.0
  web_socket_channel: ^3.0.3
  supabase_flutter: ^2.17.1
  passkeys: ^2.21.1
  shared_preferences: ^2.5.5
  speech_to_text: ^7.4.0
  flutter_tts: ^4.2.5
  permission_handler: ^13.0.1

dev_dependencies:
  flutter_test:
    sdk: flutter
  flutter_lints: ^5.0.0

flutter:
  uses-material-design: true
  assets:
    - assets/images/nexus_fx_scanner_reference.png
    - assets/images/999_Signal_Intelligence.png
