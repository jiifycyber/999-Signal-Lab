    super.key,
    required this.symbol,
    required this.timeframe,
    required this.price,
  });

  void _open(
    BuildContext context,
    Widget page,
  ) {
    Navigator.of(context).push(
      MaterialPageRoute(
        builder: (_) => page,
      ),
    );
  }

