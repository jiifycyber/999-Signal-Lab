                    ),
                  ),
                ],
              );
            },
          ),
        ],
      ),
    );
  }

  Widget _marketHeader() {
    return Container(
      padding: const EdgeInsets.all(14),
      decoration: _boxDecoration(_cyan),
      child: Wrap(
        spacing: 24,
        runSpacing: 10,
