                Wrap(
                  spacing: 8,
                  runSpacing: 8,
                  children: [
                    _commandButton(
                      'ANALYZE CHART',
                      () => _queueCommand('ANALYZE CHART'),
                    ),
                    _commandButton(
                      'DRAW KEY LEVELS',
                      () => _queueCommand('DRAW KEY LEVELS'),
                    ),
                    _commandButton(
                      'FIND PATTERNS',
                      () => _queueCommand('FIND PATTERNS'),
                    ),
                    _commandButton(
                      'FIND BREAKOUT',
                      () => _queueCommand('FIND BREAKOUT'),
                    ),
                    _commandButton(
                      'RUN MTF',
                      () => _queueCommand('RUN MTF'),
                    ),
                    _commandButton(
                      'CLEAN CHART',
                      () => _queueCommand('CLEAN CHART'),
                    ),
                  ],
                ),
                const SizedBox(height: 14),
