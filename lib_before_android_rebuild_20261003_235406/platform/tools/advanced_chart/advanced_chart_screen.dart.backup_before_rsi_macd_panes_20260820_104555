  Widget _indicatorStatusPanel() {
    if (_activeIndicators.isEmpty) {
      return const Center(
        child: Text(
          'SELECT INDICATORS FROM THE TOP TOOLBAR',
          style: TextStyle(
            color: Colors.white38,
            fontSize: 9,
            fontWeight: FontWeight.w800,
          ),
        ),
      );
    }

    final source = candles;
    final closes = source.map((candle) => candle.close).toList();

    double? lastValid(List<double?> values) {
      for (int i = values.length - 1; i >= 0; i--) {
        final value = values[i];

        if (value != null && value.isFinite) {
          return value;
        }
      }

      return null;
    }

    String valueFor(String indicator) {
      if (source.isEmpty || closes.isEmpty) {
        return '--';
      }

      if (indicator == 'SMA 20') {
        return lastValid(_sma(closes, 20))?.toStringAsFixed(5) ?? '--';
      }

      if (indicator == 'SMA 50') {
        return lastValid(_sma(closes, 50))?.toStringAsFixed(5) ?? '--';
      }

      if (indicator == 'EMA 9') {
        return lastValid(_ema(closes, 9))?.toStringAsFixed(5) ?? '--';
      }

      if (indicator == 'EMA 21') {
        return lastValid(_ema(closes, 21))?.toStringAsFixed(5) ?? '--';
      }

      if (indicator == 'EMA 50') {
        return lastValid(_ema(closes, 50))?.toStringAsFixed(5) ?? '--';
      }

      if (indicator == 'EMA 200') {
        return lastValid(_ema(closes, 200))?.toStringAsFixed(5) ?? '--';
      }

      if (indicator == 'Bollinger Bands') {
        final data = _bollinger(closes);
        return lastValid(data['middle'] ?? const <double?>[])
                ?.toStringAsFixed(5) ??
            '--';
      }

      if (indicator == 'RSI') {
        return lastValid(_rsi(closes, 14))?.toStringAsFixed(2) ?? '--';
      }

      if (indicator == 'ATR') {
        return lastValid(_atr(source))?.toStringAsFixed(5) ?? '--';
      }

      if (indicator == 'MACD') {
        final data = _macd(closes);
        return lastValid(data['macd'] ?? const <double?>[])
                ?.toStringAsFixed(5) ??
            '--';
      }

      if (indicator == 'Stochastic') {
        final data = _stochastic(source);
        return lastValid(data['k'] ?? const <double?>[])?.toStringAsFixed(2) ??
            '--';
      }

      if (indicator == 'ROC') {
        return lastValid(_roc(closes))?.toStringAsFixed(2) ?? '--';
      }

      if (indicator == 'Momentum') {
        return lastValid(_momentum(closes))?.toStringAsFixed(5) ?? '--';
      }

      if (indicator == 'OBV') {
        return lastValid(_obv(source))?.toStringAsFixed(5) ?? '--';
      }

      if (indicator == 'Williams %R') {
        if (source.length < 14) return '--';

        final recent = source.sublist(source.length - 14);

        double highest = recent.first.high;
        double lowest = recent.first.low;

        for (final candle in recent) {
          highest = math.max(highest, candle.high);
          lowest = math.min(lowest, candle.low);
        }

        final range = highest - lowest;

        if (range == 0) return '--';

        return (((highest - source.last.close) / range) * -100)
            .toStringAsFixed(2);
      }

      if (indicator == 'CCI') {
        if (source.length < 20) return '--';

        final recent = source.sublist(source.length - 20);

        final typical =
            recent.map((c) => (c.high + c.low + c.close) / 3.0).toList();

        final mean = typical.reduce((a, b) => a + b) / typical.length;

        final deviation =
            typical.map((v) => (v - mean).abs()).reduce((a, b) => a + b) /
                typical.length;

        if (deviation == 0) return '0.00';

        return ((typical.last - mean) / (0.015 * deviation)).toStringAsFixed(2);
      }

      if (indicator == 'ADX') {
        if (source.length < 15) return '--';

        double plusDm = 0;
        double minusDm = 0;
        double trueRange = 0;

        final first = math.max(1, source.length - 14);

        for (int i = first; i < source.length; i++) {
          final upMove = source[i].high - source[i - 1].high;
          final downMove = source[i - 1].low - source[i].low;

          if (upMove > downMove && upMove > 0) {
            plusDm += upMove;
          }

          if (downMove > upMove && downMove > 0) {
            minusDm += downMove;
          }

          trueRange += math.max(
            source[i].high - source[i].low,
            math.max(
              (source[i].high - source[i - 1].close).abs(),
              (source[i].low - source[i - 1].close).abs(),
            ),
          );
        }

        if (trueRange == 0) return '--';

        final plusDi = 100 * plusDm / trueRange;
        final minusDi = 100 * minusDm / trueRange;
        final total = plusDi + minusDi;

        if (total == 0) return '0.00';

        return (100 * (plusDi - minusDi).abs() / total).toStringAsFixed(2);
      }

      if (indicator == 'VWAP') {
        double weighted = 0;
        double weight = 0;

        for (final candle in source) {
          final typical = (candle.high + candle.low + candle.close) / 3.0;

          final proxy = math.max(
            (candle.high - candle.low).abs(),
            0.0000001,
          );

          weighted += typical * proxy;
          weight += proxy;
        }

        return weight > 0 ? (weighted / weight).toStringAsFixed(5) : '--';
      }

      if (indicator == 'MFI') {
        if (source.length < 15) return '--';

        double positive = 0;
        double negative = 0;

        for (int i = source.length - 14; i < source.length; i++) {
          if (i <= 0) continue;

          final current =
              (source[i].high + source[i].low + source[i].close) / 3.0;

          final previous =
              (source[i - 1].high + source[i - 1].low + source[i - 1].close) /
                  3.0;

          final proxy = math.max(
            (source[i].high - source[i].low).abs(),
            0.0000001,
          );

          final flow = current * proxy;

          if (current >= previous) {
            positive += flow;
          } else {
            negative += flow;
          }
        }

        if (negative == 0) return '100.00';

        final ratio = positive / negative;

        return (100 - (100 / (1 + ratio))).toStringAsFixed(2);
      }

      if (indicator == 'Parabolic SAR') {
        if (source.length < 2) return '--';

        final previous = source[source.length - 2];
        final current = source.last;

        final sar = current.close >= previous.close
            ? math.min(previous.low, current.low)
            : math.max(previous.high, current.high);

        return sar.toStringAsFixed(5);
      }

      if (indicator == 'Ichimoku Cloud') {
        if (source.length < 26) return '--';

        double midpoint(int period) {
          final first = math.max(0, source.length - period);

          double highest = source[first].high;
          double lowest = source[first].low;

          for (int i = first; i < source.length; i++) {
            highest = math.max(highest, source[i].high);
            lowest = math.min(lowest, source[i].low);
          }

          return (highest + lowest) / 2.0;
        }

        return '${midpoint(9).toStringAsFixed(5)} / '
            '${midpoint(26).toStringAsFixed(5)}';
      }

      if (indicator == 'ZigZag') {
        final recent =
            source.length <= 12 ? source : source.sublist(source.length - 12);

        double high = recent.first.high;
        double low = recent.first.low;

        for (final candle in recent) {
          high = math.max(high, candle.high);
          low = math.min(low, candle.low);
        }

        return '${low.toStringAsFixed(5)}–${high.toStringAsFixed(5)}';
      }

      return 'ACTIVE';
    }

    return ListView(
      scrollDirection: Axis.horizontal,
      padding: const EdgeInsets.symmetric(
        horizontal: 10,
        vertical: 7,
      ),
      children: _activeIndicators.map((indicator) {
        return Container(
          width: 125,
          margin: const EdgeInsets.only(right: 7),
          padding: const EdgeInsets.symmetric(
            horizontal: 8,
            vertical: 6,
          ),
          decoration: BoxDecoration(
            color: const Color(0xFF0B1118),
            borderRadius: BorderRadius.circular(6),
            border: Border.all(
              color: cyan.withValues(alpha: .22),
            ),
          ),
          child: Column(
            mainAxisAlignment: MainAxisAlignment.center,
            children: [
              Text(
                indicator,
                maxLines: 1,
                overflow: TextOverflow.ellipsis,
                textAlign: TextAlign.center,
                style: const TextStyle(
                  color: Colors.white60,
                  fontSize: 7,
                  fontWeight: FontWeight.w800,
                ),
              ),
              const SizedBox(height: 5),
              Text(
                valueFor(indicator),
                maxLines: 1,
                overflow: TextOverflow.ellipsis,
                textAlign: TextAlign.center,
                style: const TextStyle(
                  color: cyan,
                  fontSize: 9,
                  fontWeight: FontWeight.w900,
                ),
              ),
            ],
          ),
        );
      }).toList(),
    );
  }

  Widget _centerMessage(
    String title,
    String text,
  ) {
    return Center(
      child: Column(
        mainAxisSize: MainAxisSize.min,
        children: [
          Text(
            title,
            style: const TextStyle(
              color: cyan,
              fontSize: 9,
              fontWeight: FontWeight.w900,
            ),
          ),
          const SizedBox(height: 5),
          Text(
            text,
            textAlign: TextAlign.center,
            style: const TextStyle(
              color: Colors.white54,
              fontSize: 9,
            ),
          ),
        ],
      ),
