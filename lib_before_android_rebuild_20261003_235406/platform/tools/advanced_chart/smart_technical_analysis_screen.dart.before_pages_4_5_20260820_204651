class PatternIntelligenceScreen extends StatefulWidget {
  final String symbol;
  final String timeframe;
  final double price;

  const PatternIntelligenceScreen({
    super.key,
    required this.symbol,
    required this.timeframe,
    required this.price,
  });

  @override
  State<PatternIntelligenceScreen> createState() =>
      _PatternIntelligenceScreenState();
}

class _PatternIntelligenceScreenState extends State<PatternIntelligenceScreen> {
  bool chartPatterns = true;
  bool candlePatterns = true;
  bool reversalPatterns = true;
  bool continuationPatterns = true;
  bool harmonicPatterns = true;
  bool autoScan = true;

  String sensitivity = 'BALANCED';
  String selectedCategory = 'ALL';

  final List<Map<String, String>> detectedPatterns = [];

  void _scanPatterns() {
    setState(() {
      detectedPatterns.clear();
    });

    ScaffoldMessenger.of(context).showSnackBar(
      const SnackBar(
        content: Text(
          'Pattern scan requested. Detection results will populate from the Smart Analysis engine.',
        ),
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    return _DedicatedSmartPage(
      title: 'PATTERN INTELLIGENCE',
      subtitle: 'AI chart-pattern + candlestick recognition command center',
      symbol: widget.symbol,
      timeframe: widget.timeframe,
      price: widget.price,
      color: _green,
      body: Column(
        children: [
          LayoutBuilder(
            builder: (_, constraints) {
              if (constraints.maxWidth < 900) {
                return Column(
                  children: [
                    _patternControls(),
                    const SizedBox(height: 14),
                    _patternSummary(),
                  ],
                );
              }

              return Row(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  SizedBox(
                    width: 330,
                    child: _patternControls(),
                  ),
                  const SizedBox(width: 14),
                  Expanded(
                    child: _patternSummary(),
                  ),
                ],
              );
            },
          ),
          const SizedBox(height: 14),
          _patternScannerTable(),
          const SizedBox(height: 14),
          _candlestickSection(),
        ],
      ),
    );
  }

  Widget _patternControls() {
    return _controlPanel(
      title: 'PATTERN ENGINE CONTROLS',
      children: [
        _switchRow(
          'Automatic Pattern Scan',
          autoScan,
          (v) => setState(() => autoScan = v),
        ),
        _switchRow(
          'Chart Patterns',
          chartPatterns,
          (v) => setState(() => chartPatterns = v),
        ),
        _switchRow(
          'Candlestick Patterns',
          candlePatterns,
          (v) => setState(() => candlePatterns = v),
        ),
        _switchRow(
          'Reversal Patterns',
          reversalPatterns,
          (v) => setState(() => reversalPatterns = v),
        ),
        _switchRow(
          'Continuation Patterns',
          continuationPatterns,
          (v) => setState(() => continuationPatterns = v),
        ),
        _switchRow(
          'Harmonic Pattern Layer',
          harmonicPatterns,
          (v) => setState(() => harmonicPatterns = v),
        ),
        const SizedBox(height: 12),
        const Text(
          'SENSITIVITY',
          style: TextStyle(
            color: Colors.white38,
            fontSize: 10,
            fontWeight: FontWeight.w900,
          ),
        ),
        const SizedBox(height: 8),
        Wrap(
          spacing: 6,
          runSpacing: 6,
          children: [
            for (final value in [
              'CONSERVATIVE',
              'BALANCED',
              'ENHANCED',
            ])
              ChoiceChip(
                label: Text(value),
                selected: sensitivity == value,
                onSelected: (_) {
                  setState(() {
                    sensitivity = value;
                  });
                },
              ),
          ],
        ),
        const SizedBox(height: 12),
        SizedBox(
          width: double.infinity,
          child: FilledButton.icon(
            onPressed: _scanPatterns,
            icon: const Icon(Icons.radar),
            label: const Text('SCAN CURRENT CHART'),
          ),
        ),
      ],
    );
  }

  Widget _patternSummary() {
    return Container(
      width: double.infinity,
      padding: const EdgeInsets.all(16),
      decoration: _boxDecoration(_green),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          const Text(
            'AI PATTERN SUMMARY',
            style: TextStyle(
              color: _green,
              fontWeight: FontWeight.w900,
              letterSpacing: .8,
            ),
          ),
          const SizedBox(height: 14),
          _patternMetric(
            'CURRENT SYMBOL',
            widget.symbol,
            _cyan,
          ),
          _patternMetric(
            'ACTIVE TIMEFRAME',
            widget.timeframe,
            _amber,
          ),
          _patternMetric(
            'SCAN MODE',
            autoScan ? 'AUTOMATIC' : 'MANUAL',
            autoScan ? _green : _amber,
          ),
          _patternMetric(
            'SENSITIVITY',
            sensitivity,
            _cyan,
          ),
          _patternMetric(
            'DETECTED PATTERNS',
            '${detectedPatterns.length}',
            detectedPatterns.isEmpty ? _amber : _green,
          ),
          _patternMetric(
            'ENGINE STATE',
            detectedPatterns.isEmpty
                ? 'READY FOR MARKET ANALYSIS'
                : 'PATTERNS DETECTED',
            detectedPatterns.isEmpty ? _amber : _green,
          ),
        ],
      ),
    );
  }

  Widget _patternScannerTable() {
    return Container(
      width: double.infinity,
      padding: const EdgeInsets.all(16),
      decoration: _boxDecoration(_green),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Row(
            children: [
              const Expanded(
                child: Text(
                  'DETECTED PATTERNS',
                  style: TextStyle(
                    color: Colors.white,
                    fontWeight: FontWeight.w900,
                  ),
                ),
              ),
              DropdownButton<String>(
                value: selectedCategory,
                dropdownColor: _panel2,
                items: const [
                  DropdownMenuItem(
                    value: 'ALL',
                    child: Text('ALL'),
                  ),
                  DropdownMenuItem(
                    value: 'REVERSAL',
                    child: Text('REVERSAL'),
                  ),
                  DropdownMenuItem(
                    value: 'CONTINUATION',
                    child: Text('CONTINUATION'),
                  ),
                  DropdownMenuItem(
                    value: 'CANDLE',
                    child: Text('CANDLE'),
                  ),
                ],
                onChanged: (value) {
                  if (value != null) {
                    setState(() {
                      selectedCategory = value;
                    });
                  }
                },
              ),
            ],
          ),
          const SizedBox(height: 12),
          const Row(
            children: [
              Expanded(
                flex: 2,
                child: Text(
                  'PATTERN',
                  style: TextStyle(
                    color: Colors.white38,
                    fontWeight: FontWeight.w900,
                  ),
                ),
              ),
              Expanded(
                child: Text(
                  'DIRECTION',
                  style: TextStyle(
                    color: Colors.white38,
                    fontWeight: FontWeight.w900,
                  ),
                ),
              ),
              Expanded(
                child: Text(
                  'CONFIDENCE',
                  style: TextStyle(
                    color: Colors.white38,
                    fontWeight: FontWeight.w900,
                  ),
                ),
              ),
              Expanded(
                child: Text(
                  'STATUS',
                  textAlign: TextAlign.right,
                  style: TextStyle(
                    color: Colors.white38,
                    fontWeight: FontWeight.w900,
                  ),
                ),
              ),
            ],
          ),
          const Divider(color: Colors.white10),
          if (detectedPatterns.isEmpty)
            Container(
              width: double.infinity,
              padding: const EdgeInsets.symmetric(
                vertical: 28,
              ),
              alignment: Alignment.center,
              child: const Column(
                children: [
                  Icon(
                    Icons.polyline,
                    color: Colors.white24,
                    size: 38,
                  ),
                  SizedBox(height: 10),
                  Text(
                    'NO PATTERN ANALYSIS HAS RUN YET',
                    style: TextStyle(
                      color: Colors.white54,
                      fontWeight: FontWeight.w900,
                    ),
                  ),
                  SizedBox(height: 5),
                  Text(
                    'The pattern engine will populate this table from real candle analysis.',
                    textAlign: TextAlign.center,
                    style: TextStyle(
                      color: Colors.white30,
                    ),
                  ),
                ],
              ),
            ),
          for (final pattern in detectedPatterns) _patternResultRow(pattern),
        ],
      ),
    );
  }

  Widget _candlestickSection() {
    return Container(
      width: double.infinity,
      padding: const EdgeInsets.all(16),
      decoration: _boxDecoration(_cyan),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          const Text(
            'CANDLESTICK INTELLIGENCE',
            style: TextStyle(
              color: _cyan,
              fontWeight: FontWeight.w900,
            ),
          ),
          const SizedBox(height: 12),
          Wrap(
            spacing: 10,
            runSpacing: 10,
            children: [
              _patternTypeCard('ENGULFING'),
              _patternTypeCard('PIN BAR'),
              _patternTypeCard('DOJI'),
              _patternTypeCard('MORNING STAR'),
              _patternTypeCard('EVENING STAR'),
              _patternTypeCard('INSIDE BAR'),
              _patternTypeCard('HAMMER'),
              _patternTypeCard('SHOOTING STAR'),
            ],
          ),
        ],
      ),
    );
  }

  Widget _patternTypeCard(String name) {
    return Container(
      width: 155,
      padding: const EdgeInsets.all(12),
      decoration: BoxDecoration(
        color: Colors.black.withValues(alpha: .16),
        borderRadius: BorderRadius.circular(6),
        border: Border.all(
          color: Colors.white10,
        ),
      ),
      child: Column(
        children: [
          Text(
            name,
            textAlign: TextAlign.center,
            style: const TextStyle(
              color: Colors.white70,
              fontWeight: FontWeight.w800,
              fontSize: 11,
            ),
          ),
          const SizedBox(height: 7),
          const Text(
            'READY',
            style: TextStyle(
              color: _green,
              fontWeight: FontWeight.w900,
              fontSize: 10,
            ),
          ),
        ],
      ),
    );
  }

  Widget _patternMetric(
    String label,
    String value,
    Color color,
  ) {
    return Container(
      padding: const EdgeInsets.symmetric(vertical: 9),
      decoration: const BoxDecoration(
        border: Border(
          bottom: BorderSide(color: Colors.white10),
        ),
      ),
      child: Row(
        children: [
          Expanded(
            child: Text(
              label,
              style: const TextStyle(
                color: Colors.white46,
                fontSize: 11,
              ),
            ),
          ),
          Text(
            value,
            style: TextStyle(
              color: color,
              fontWeight: FontWeight.w900,
            ),
          ),
        ],
      ),
    );
  }

  Widget _patternResultRow(Map<String, String> pattern) {
    return Padding(
      padding: const EdgeInsets.symmetric(vertical: 9),
      child: Row(
        children: [
          Expanded(
            flex: 2,
            child: Text(
              pattern['name'] ?? '--',
              style: const TextStyle(
                color: Colors.white,
                fontWeight: FontWeight.w800,
              ),
            ),
          ),
          Expanded(
            child: Text(
              pattern['direction'] ?? '--',
            ),
          ),
          Expanded(
            child: Text(
              pattern['confidence'] ?? '--',
            ),
          ),
          Expanded(
            child: Text(
              pattern['status'] ?? '--',
              textAlign: TextAlign.right,
            ),
          ),
        ],
      ),
    );
  }
}

