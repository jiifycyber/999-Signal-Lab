          );

        case 'Standard Deviation':
          return genericPane(
            title: indicator.title,
            series: <List<double?>>[
              _stdDev(
                closes,
                indicator.length,
              ),
            ],
            colors: const <Color>[
              Color(0xFFB388FF),
            ],
            borderColor: purple,
          );

        default:
          return null;
      }
    }

    final panes = <Widget>[];

    for (final indicator in active) {
      final pane = buildIndicatorPane(indicator);

      if (pane != null) {
        panes.add(pane);
      }
    }

    if (_showVolumePane) {
      panes.add(
        _volumeActivityPane(),
      );
    }

    if (panes.isEmpty) {
      return _chartPanel();
    }

    return LayoutBuilder(
      builder: (context, constraints) {
        final wantedHeight = panes.length * 137.0;

        final maxPaneHeight = constraints.maxHeight * 0.46;

        final paneRegionHeight = math.min(
          wantedHeight,
          math.max(132.0, maxPaneHeight),
        );

        return Column(
          children: [
            Expanded(
              child: _chartPanel(),
            ),
            SizedBox(
              height: paneRegionHeight,
              child: ListView(
                padding: EdgeInsets.zero,
                children: panes,
              ),
            ),
          ],
        );
      },
    );
  }

