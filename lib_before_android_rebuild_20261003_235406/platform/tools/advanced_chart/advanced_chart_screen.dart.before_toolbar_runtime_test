  List<double?> _rma(
    List<double> values,
    int period,
  ) {
    final result = List<double?>.filled(values.length, null);

    if (period <= 0 || values.length < period) {
      return result;
    }

    double seed = 0;

    for (int i = 0; i < period; i++) {
      seed += values[i];
    }

    double value = seed / period;
    result[period - 1] = value;

    for (int i = period; i < values.length; i++) {
      value = ((value * (period - 1)) + values[i]) / period;
      result[i] = value;
    }

    return result;
  }

  List<double?> _wma(
    List<double> values,
    int period,
  ) {
    final result = List<double?>.filled(values.length, null);

    if (period <= 0 || values.length < period) {
      return result;
    }

    final denominator = period * (period + 1) / 2.0;

    for (int i = period - 1; i < values.length; i++) {
      double weighted = 0;

      for (int j = 0; j < period; j++) {
        weighted += values[i - period + 1 + j] * (j + 1);
      }

      result[i] = weighted / denominator;
    }

    return result;
  }

  List<double?> _dema(
    List<double> values,
    int period,
  ) {
    final ema1 = _ema(values, period);

    final compact = <double>[];
    final indexes = <int>[];

    for (int i = 0; i < ema1.length; i++) {
      final value = ema1[i];

      if (value != null && value.isFinite) {
        compact.add(value);
        indexes.add(i);
      }
    }

    final ema2Compact = _ema(compact, period);
    final result = List<double?>.filled(values.length, null);

    for (int i = 0; i < compact.length; i++) {
      final second = ema2Compact[i];

      if (second != null) {
        result[indexes[i]] = (2 * compact[i]) - second;
      }
    }

    return result;
  }

  List<double?> _tema(
    List<double> values,
    int period,
  ) {
    final ema1 = _ema(values, period);

    final firstCompact = <double>[];
    final firstIndexes = <int>[];

    for (int i = 0; i < ema1.length; i++) {
      final value = ema1[i];

      if (value != null && value.isFinite) {
        firstCompact.add(value);
        firstIndexes.add(i);
      }
    }

    final ema2Compact = _ema(firstCompact, period);

    final secondCompact = <double>[];
    final secondOriginalIndexes = <int>[];

    for (int i = 0; i < ema2Compact.length; i++) {
      final value = ema2Compact[i];

      if (value != null && value.isFinite) {
        secondCompact.add(value);
        secondOriginalIndexes.add(firstIndexes[i]);
      }
    }

    final ema3Compact = _ema(secondCompact, period);
    final result = List<double?>.filled(values.length, null);

    for (int i = 0; i < ema3Compact.length; i++) {
      final third = ema3Compact[i];

      if (third == null) continue;

      final originalIndex = secondOriginalIndexes[i];
      final first = ema1[originalIndex];

      int secondPosition = -1;

      for (int j = 0; j < firstIndexes.length; j++) {
        if (firstIndexes[j] == originalIndex) {
          secondPosition = j;
          break;
        }
      }

      if (first != null &&
          secondPosition >= 0 &&
          secondPosition < ema2Compact.length &&
          ema2Compact[secondPosition] != null) {
        result[originalIndex] =
            (3 * first) - (3 * ema2Compact[secondPosition]!) + third;
      }
    }

    return result;
  }

  List<double?> _hma(
    List<double> values,
    int period,
  ) {
    final safePeriod = math.max(1, period);
    final half = math.max(1, safePeriod ~/ 2);
    final root = math.max(1, math.sqrt(safePeriod).round());

    final fullWma = _wma(values, safePeriod);
    final halfWma = _wma(values, half);

    final intermediate = List<double?>.filled(values.length, null);

    for (int i = 0; i < values.length; i++) {
      final full = fullWma[i];
      final halfValue = halfWma[i];

      if (full != null && halfValue != null) {
        intermediate[i] = (2 * halfValue) - full;
      }
    }

    final compact = <double>[];
    final indexes = <int>[];

    for (int i = 0; i < intermediate.length; i++) {
      final value = intermediate[i];

      if (value != null && value.isFinite) {
        compact.add(value);
        indexes.add(i);
      }
    }

    final smoothed = _wma(compact, root);
    final result = List<double?>.filled(values.length, null);

    for (int i = 0; i < smoothed.length; i++) {
      final value = smoothed[i];

      if (value != null) {
        result[indexes[i]] = value;
      }
    }

    return result;
  }

  List<double?> _kama(
    List<double> values, {
    int period = 10,
    int fastPeriod = 2,
    int slowPeriod = 30,
  }) {
    final result = List<double?>.filled(values.length, null);

    if (values.length <= period || period <= 0) {
      return result;
    }

    final fastAlpha = 2.0 / (fastPeriod + 1.0);
    final slowAlpha = 2.0 / (slowPeriod + 1.0);

    double kama = values[period];
    result[period] = kama;

    for (int i = period + 1; i < values.length; i++) {
      final change = (values[i] - values[i - period]).abs();

      double volatility = 0;

      for (int j = i - period + 1; j <= i; j++) {
        volatility += (values[j] - values[j - 1]).abs();
      }

      final efficiencyRatio = volatility == 0 ? 0.0 : change / volatility;

      final smoothing = math
          .pow(
            efficiencyRatio * (fastAlpha - slowAlpha) + slowAlpha,
            2,
          )
          .toDouble();

      kama += smoothing * (values[i] - kama);
      result[i] = kama;
    }

    return result;
  }

  List<double?> _stdDev(
    List<double> values,
    int period,
  ) {
    final result = List<double?>.filled(values.length, null);

    if (period <= 0 || values.length < period) {
      return result;
    }

    for (int i = period - 1; i < values.length; i++) {
      double sum = 0;

      for (int j = i - period + 1; j <= i; j++) {
        sum += values[j];
      }

      final mean = sum / period;
      double variance = 0;

      for (int j = i - period + 1; j <= i; j++) {
        final delta = values[j] - mean;
        variance += delta * delta;
      }

      result[i] = math.sqrt(variance / period);
    }

    return result;
  }

  Map<String, List<double?>> _donchian(
    List<_OhlcCandle> source,
    int period,
  ) {
    final upper = List<double?>.filled(source.length, null);
    final middle = List<double?>.filled(source.length, null);
    final lower = List<double?>.filled(source.length, null);

    if (period <= 0 || source.length < period) {
      return {
        'upper': upper,
        'middle': middle,
        'lower': lower,
      };
    }

    for (int i = period - 1; i < source.length; i++) {
      double highest = source[i - period + 1].high;
      double lowest = source[i - period + 1].low;

      for (int j = i - period + 1; j <= i; j++) {
        highest = math.max(highest, source[j].high);
        lowest = math.min(lowest, source[j].low);
      }

      upper[i] = highest;
      lower[i] = lowest;
      middle[i] = (highest + lowest) / 2.0;
    }

    return {
      'upper': upper,
      'middle': middle,
      'lower': lower,
    };
  }

