  Widget _indicatorStatusPanel() {
    final active = _activeIndicators.where((item) => item.visible).toList();

    if (active.isEmpty) {
      return const Center(
        child: Text(
          'SELECT INDICATORS FROM THE TOP TOOLBAR',
          style: TextStyle(
            color: Colors.white38,
            fontSize: 9,
            fontWeight: FontWeight.w800,
          ),
        ),
      );
    }

    final source = candles;
    final closes = source.map((candle) => candle.close).toList();

    double? lastValid(List<double?> values) {
      for (int i = values.length - 1; i >= 0; i--) {
        final value = values[i];

        if (value != null && value.isFinite) {
          return value;
        }
      }

      return null;
    }

    final rsiConfigs =
        active.where((item) => item.type == 'Relative Strength Index').toList();

    final macdConfigs = active.where((item) => item.type == 'MACD').toList();

    if (rsiConfigs.isNotEmpty || macdConfigs.isNotEmpty) {
      final rsiConfig = rsiConfigs.isNotEmpty ? rsiConfigs.last : null;

      final macdConfig = macdConfigs.isNotEmpty ? macdConfigs.last : null;

      final rsiValues = rsiConfig == null
          ? const <double?>[]
          : _rsi(
              closes,
              rsiConfig.length,
            );

      final macdData = macdConfig == null
          ? <String, List<double?>>{}
          : _macd(
              closes,
              fastPeriod: macdConfig.length,
              slowPeriod: macdConfig.length2,
              signalPeriod: macdConfig.length3,
            );

      final macdValues = macdData['macd'] ?? const <double?>[];

      final signalValues = macdData['signal'] ?? const <double?>[];

      final histogramValues = macdData['histogram'] ?? const <double?>[];

      return Padding(
        padding: const EdgeInsets.fromLTRB(
          8,
          4,
          8,
          6,
        ),
        child: Row(
          children: [
            if (rsiConfig != null)
              Expanded(
                child: Container(
                  margin: EdgeInsets.only(
                    right: macdConfig != null ? 4 : 0,
                  ),
                  decoration: BoxDecoration(
                    color: const Color(0xFF081018),
                    borderRadius: BorderRadius.circular(6),
                    border: Border.all(
                      color: cyan.withValues(alpha: .22),
                    ),
                  ),
                  child: CustomPaint(
                    painter: _RsiPainter(
                      values: rsiValues,
                      period: rsiConfig.length,
                      upperLevel: rsiConfig.value1 == 0 ? 70 : rsiConfig.value1,
                      lowerLevel: rsiConfig.value2 == 0 ? 30 : rsiConfig.value2,
                    ),
                    child: const SizedBox.expand(),
                  ),
                ),
              ),
            if (macdConfig != null)
              Expanded(
                child: Container(
                  margin: EdgeInsets.only(
                    left: rsiConfig != null ? 4 : 0,
                  ),
                  decoration: BoxDecoration(
                    color: const Color(0xFF081018),
                    borderRadius: BorderRadius.circular(6),
                    border: Border.all(
                      color: purple.withValues(alpha: .22),
                    ),
                  ),
                  child: CustomPaint(
                    painter: _MacdPainter(
                      macd: macdValues,
                      signal: signalValues,
                      histogram: histogramValues,
                      fastPeriod: macdConfig.length,
                      slowPeriod: macdConfig.length2,
                      signalPeriod: macdConfig.length3,
                    ),
                    child: const SizedBox.expand(),
                  ),
                ),
              ),
          ],
        ),
      );
    }

    String valueFor(_IndicatorConfig indicator) {
      if (source.isEmpty || closes.isEmpty) {
        return '--';
      }

      switch (indicator.type) {
        case 'Moving Average':
          return lastValid(
                _sma(closes, indicator.length),
              )?.toStringAsFixed(5) ??
              '--';

        case 'Exponential Moving Average':
          return lastValid(
                _ema(closes, indicator.length),
              )?.toStringAsFixed(5) ??
              '--';

        case 'Weighted Moving Average':
          if (closes.length < indicator.length) {
            return '--';
          }

          final period = indicator.length;
          final denominator = period * (period + 1) / 2.0;

          double weighted = 0;

          for (int i = 0; i < period; i++) {
            weighted += closes[closes.length - period + i] * (i + 1);
          }

          return (weighted / denominator).toStringAsFixed(5);

        case 'Smoothed Moving Average':
          return lastValid(
                _rma(
                  closes,
                  indicator.length,
                ),
              )?.toStringAsFixed(5) ??
              '--';

        case 'Double Exponential Moving Average':
          return lastValid(
                _dema(
                  closes,
                  indicator.length,
                ),
              )?.toStringAsFixed(5) ??
              '--';

        case 'Triple Exponential Moving Average':
          return lastValid(
                _tema(
                  closes,
                  indicator.length,
                ),
              )?.toStringAsFixed(5) ??
              '--';

        case 'Hull Moving Average':
          return lastValid(
                _hma(
                  closes,
                  indicator.length,
                ),
              )?.toStringAsFixed(5) ??
              '--';

        case 'Kaufman Adaptive Moving Average':
          return lastValid(
                _kama(
                  closes,
                  period: indicator.length,
                ),
              )?.toStringAsFixed(5) ??
              '--';

        case 'Bollinger Bands':
          final data = _bollinger(
            closes,
            period: indicator.length,
            deviation: indicator.value1 == 0 ? 2.0 : indicator.value1,
          );

          return lastValid(
                data['middle'] ?? const <double?>[],
              )?.toStringAsFixed(5) ??
              '--';

        case 'Envelopes':
          final period = indicator.length.clamp(1, 5000);
          final deviation =
              indicator.value1 == 0 ? 0.1 : indicator.value1.abs();

          final basis = _sma(
            closes,
            period,
          );

          final middle = lastValid(basis);

          if (middle == null) return '--';

          final upper = middle * (1 + deviation / 100.0);
          final lower = middle * (1 - deviation / 100.0);

          return '${lower.toStringAsFixed(5)} / '
              '${middle.toStringAsFixed(5)} / '
              '${upper.toStringAsFixed(5)}';

        case 'Donchian Channels':
          final data = _donchian(
            source,
            indicator.length,
          );

          final upper = lastValid(data['upper'] ?? const <double?>[]);

          final middle = lastValid(data['middle'] ?? const <double?>[]);

          final lower = lastValid(data['lower'] ?? const <double?>[]);

          if (upper == null || middle == null || lower == null) {
            return '--';
          }

          return '${lower.toStringAsFixed(5)} / '
              '${middle.toStringAsFixed(5)} / '
              '${upper.toStringAsFixed(5)}';

        case 'Keltner Channels':
          final basis = _ema(
            closes,
            indicator.length,
          );

          final atr = _atr(
            source,
            period:
                indicator.length2 > 0 ? indicator.length2 : indicator.length,
          );

          final middle = lastValid(basis);
          final range = lastValid(atr);

          if (middle == null || range == null) return '--';

          final multiplier =
              indicator.value1 == 0 ? 2.0 : indicator.value1.abs();

          final upper = middle + multiplier * range;
          final lower = middle - multiplier * range;

          return '${lower.toStringAsFixed(5)} / '
              '${middle.toStringAsFixed(5)} / '
              '${upper.toStringAsFixed(5)}';

        case 'Standard Deviation':
          return lastValid(
                _stdDev(
                  closes,
                  indicator.length,
                ),
              )?.toStringAsFixed(5) ??
              '--';

        case 'Relative Strength Index':
          return lastValid(
                _rsi(closes, indicator.length),
              )?.toStringAsFixed(2) ??
              '--';

        case 'MACD':
          final data = _macd(
            closes,
            fastPeriod: indicator.length,
            slowPeriod: indicator.length2,
            signalPeriod: indicator.length3,
          );

          return lastValid(
                data['macd'] ?? const <double?>[],
              )?.toStringAsFixed(5) ??
              '--';

        case 'Stochastic Oscillator':
          final data = _stochastic(
            source,
            period: indicator.length,
            smoothK: indicator.length2,
            dPeriod: indicator.length3,
          );

          final k = lastValid(
            data['k'] ?? const <double?>[],
          );

          final d = lastValid(
            data['d'] ?? const <double?>[],
          );

          if (k == null) return '--';

          return d == null
              ? k.toStringAsFixed(2)
              : '${k.toStringAsFixed(2)} / ${d.toStringAsFixed(2)}';

        case 'Average True Range':
          return lastValid(
                _atr(
                  source,
                  period: indicator.length,
                ),
              )?.toStringAsFixed(5) ??
              '--';

        case 'Commodity Channel Index':
          final period = indicator.length;

          if (source.length < period) return '--';

          final recent = source.sublist(source.length - period);

          final typical = recent
              .map(
                (c) => (c.high + c.low + c.close) / 3.0,
              )
              .toList();

          final mean = typical.reduce((a, b) => a + b) / typical.length;

          final deviation =
              typical.map((v) => (v - mean).abs()).reduce((a, b) => a + b) /
                  typical.length;

          if (deviation == 0) return '0.00';

          return ((typical.last - mean) / (0.015 * deviation))
              .toStringAsFixed(2);

        case 'Williams %R':
          final period = indicator.length;

          if (source.length < period) return '--';

          final recent = source.sublist(source.length - period);

          double highest = recent.first.high;
          double lowest = recent.first.low;

          for (final candle in recent) {
            highest = math.max(highest, candle.high);
            lowest = math.min(lowest, candle.low);
          }

          final range = highest - lowest;

          if (range == 0) return '--';

          return (((highest - source.last.close) / range) * -100)
              .toStringAsFixed(2);

        case 'Momentum':
          return lastValid(
                _momentum(
                  closes,
                  period: indicator.length,
                ),
              )?.toStringAsFixed(5) ??
              '--';

        case 'Rate of Change':
          return lastValid(
                _roc(
                  closes,
                  period: indicator.length,
                ),
              )?.toStringAsFixed(2) ??
              '--';

        case 'On Balance Volume':
          return lastValid(
                _obv(source),
              )?.toStringAsFixed(5) ??
              '--';

        case 'Awesome Oscillator':
          return lastValid(
                _awesomeOscillator(source),
              )?.toStringAsFixed(5) ??
              '--';

        case 'Bulls Power':
          return lastValid(
                _bullsPower(
                  source,
                  indicator.length,
                ),
              )?.toStringAsFixed(5) ??
              '--';

        case 'Bears Power':
          return lastValid(
                _bearsPower(
                  source,
                  indicator.length,
                ),
              )?.toStringAsFixed(5) ??
              '--';

        case 'DeMarker':
          return lastValid(
                _deMarker(
                  source,
                  indicator.length,
                ),
              )?.toStringAsFixed(2) ??
              '--';

        case 'Stochastic RSI':
          final data = _stochasticRsi(
            closes,
            rsiPeriod: indicator.length,
            stochasticPeriod: indicator.length2 > 0 ? indicator.length2 : 14,
            smoothK: indicator.length3 > 0 ? indicator.length3 : 3,
          );

          final k = lastValid(
            data['k'] ?? const <double?>[],
          );

          final d = lastValid(
            data['d'] ?? const <double?>[],
          );

          if (k == null) return '--';

          return d == null
              ? k.toStringAsFixed(2)
              : '${k.toStringAsFixed(2)} / ${d.toStringAsFixed(2)}';

        case 'Ultimate Oscillator':
          return lastValid(
                _ultimateOscillator(source),
              )?.toStringAsFixed(2) ??
              '--';

        case 'Aroon':
          final data = _aroon(
            source,
            indicator.length,
          );

          final up = lastValid(
            data['up'] ?? const <double?>[],
          );

          final down = lastValid(
            data['down'] ?? const <double?>[],
          );

          if (up == null || down == null) return '--';

          return '${up.toStringAsFixed(1)} / '
              '${down.toStringAsFixed(1)}';

        case 'TRIX':
          return lastValid(
                _trix(
                  closes,
                  indicator.length,
                ),
              )?.toStringAsFixed(3) ??
              '--';

        case 'Detrended Price Oscillator':
          return lastValid(
                _dpo(
                  closes,
                  indicator.length,
                ),
              )?.toStringAsFixed(5) ??
              '--';

        case 'Fisher Transform':
          return lastValid(
                _fisherTransform(
                  source,
                  indicator.length,
                ),
              )?.toStringAsFixed(3) ??
              '--';

        case 'Money Flow Index':
          final period = indicator.length;

          if (source.length <= period) return '--';

          double positive = 0;
          double negative = 0;

          for (int i = source.length - period; i < source.length; i++) {
            if (i <= 0) continue;

            final current =
                (source[i].high + source[i].low + source[i].close) / 3.0;

            final previous =
                (source[i - 1].high + source[i - 1].low + source[i - 1].close) /
                    3.0;

            final proxy = math.max(
              (source[i].high - source[i].low).abs(),
              0.0000001,
            );

            final flow = current * proxy;

            if (current >= previous) {
              positive += flow;
            } else {
              negative += flow;
            }
          }

          if (negative == 0) return '100.00';

          final ratio = positive / negative;

          return (100 - (100 / (1 + ratio))).toStringAsFixed(2);

        case 'ADX / DMI':
          final period = indicator.length;

          if (source.length <= period) return '--';

          double plusDm = 0;
          double minusDm = 0;
          double trueRange = 0;

          final first = math.max(1, source.length - period);

          for (int i = first; i < source.length; i++) {
            final upMove = source[i].high - source[i - 1].high;

            final downMove = source[i - 1].low - source[i].low;

            if (upMove > downMove && upMove > 0) {
              plusDm += upMove;
            }

            if (downMove > upMove && downMove > 0) {
              minusDm += downMove;
            }

            trueRange += math.max(
              source[i].high - source[i].low,
              math.max(
                (source[i].high - source[i - 1].close).abs(),
                (source[i].low - source[i - 1].close).abs(),
              ),
            );
          }

          if (trueRange == 0) return '--';

          final plusDi = 100 * plusDm / trueRange;

          final minusDi = 100 * minusDm / trueRange;

          final total = plusDi + minusDi;

          if (total == 0) return '0.00';

          final adx = 100 * (plusDi - minusDi).abs() / total;

          return '${adx.toStringAsFixed(1)}  '
              '+${plusDi.toStringAsFixed(1)}  '
              '-${minusDi.toStringAsFixed(1)}';

        case 'VWAP':
          double weighted = 0;
          double weight = 0;

          for (final candle in source) {
            final typical = (candle.high + candle.low + candle.close) / 3.0;

            final proxy = math.max(
              (candle.high - candle.low).abs(),
              0.0000001,
            );

            weighted += typical * proxy;
            weight += proxy;
          }

          return weight > 0 ? (weighted / weight).toStringAsFixed(5) : '--';

        case 'Parabolic SAR':
          if (source.length < 2) return '--';

          final previous = source[source.length - 2];

          final current = source.last;

          final sar = current.close >= previous.close
              ? math.min(
                  previous.low,
                  current.low,
                )
              : math.max(
                  previous.high,
                  current.high,
                );

          return sar.toStringAsFixed(5);

        case 'Ichimoku Cloud':
          final fastPeriod = math.max(1, indicator.length);

          final basePeriod = math.max(1, indicator.length2);

          if (source.length < basePeriod) {
            return '--';
          }

          double midpoint(int period) {
            final first = math.max(0, source.length - period);

            double highest = source[first].high;
            double lowest = source[first].low;

            for (int i = first; i < source.length; i++) {
              highest = math.max(highest, source[i].high);

              lowest = math.min(lowest, source[i].low);
            }

            return (highest + lowest) / 2.0;
          }

          return '${midpoint(fastPeriod).toStringAsFixed(5)} / '
              '${midpoint(basePeriod).toStringAsFixed(5)}';

        case 'ZigZag':
          final depth = math.max(
            2,
            indicator.length,
          );

          final recent = source.length <= depth
              ? source
              : source.sublist(
                  source.length - depth,
                );

          double high = recent.first.high;
          double low = recent.first.low;

          for (final candle in recent) {
            high = math.max(high, candle.high);
            low = math.min(low, candle.low);
          }

          return '${low.toStringAsFixed(5)}–${high.toStringAsFixed(5)}';

        default:
          return 'ACTIVE';
      }
    }

    return ListView(
      scrollDirection: Axis.horizontal,
      padding: const EdgeInsets.symmetric(
        horizontal: 10,
        vertical: 7,
      ),
      children: active.map((config) {
        return Container(
          width: 145,
          margin: const EdgeInsets.only(right: 7),
          padding: const EdgeInsets.symmetric(
            horizontal: 8,
            vertical: 6,
          ),
          decoration: BoxDecoration(
            color: const Color(0xFF0B1118),
            borderRadius: BorderRadius.circular(6),
            border: Border.all(
              color: cyan.withValues(alpha: .22),
            ),
          ),
          child: Column(
            mainAxisAlignment: MainAxisAlignment.center,
            children: [
              Text(
                config.title,
                maxLines: 1,
                overflow: TextOverflow.ellipsis,
                textAlign: TextAlign.center,
                style: const TextStyle(
                  color: Colors.white60,
                  fontSize: 7,
                  fontWeight: FontWeight.w800,
                ),
              ),
              const SizedBox(height: 5),
              Text(
                valueFor(config),
                maxLines: 1,
                overflow: TextOverflow.ellipsis,
                textAlign: TextAlign.center,
                style: const TextStyle(
                  color: cyan,
                  fontSize: 9,
                  fontWeight: FontWeight.w900,
                ),
              ),
            ],
          ),
        );
      }).toList(),
    );
  }

  Widget _centerMessage(
    String title,
    String text,
  ) {
    return Center(
      child: Column(
        mainAxisSize: MainAxisSize.min,
        children: [
          Text(
            title,
            style: const TextStyle(
