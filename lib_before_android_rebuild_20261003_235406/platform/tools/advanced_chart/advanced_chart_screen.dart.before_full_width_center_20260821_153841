  void _handleChartTap(
    TapDownDetails details,
    Size size,
  ) {
    final point = _normalizeChartPoint(
      details.localPosition,
      size,
    );

    switch (_activeDrawingTool) {
      case 'crosshair':
        setState(() {
          _crosshairPosition = point;
          showCrosshair = true;
        });
        break;

      case 'horizontal':
        _commitDrawing(
          _ChartDrawing(
            kind: 'horizontal',
            points: <Offset>[point],
          ),
        );
        break;

      case 'vertical':
        _commitDrawing(
          _ChartDrawing(
            kind: 'vertical',
            points: <Offset>[point],
          ),
        );
        break;

      case 'text':
        _addChartText(point);
        break;

      case 'zoom':
        _zoomIn();
        break;
    }
  }

  void _handleChartPanStart(
    DragStartDetails details,
    Size size,
  ) {
    if (!_drawingToolUsesDrag) {
      _chartPanDragRemainder = 0.0;
      return;
    }

    final point = _normalizeChartPoint(
      details.localPosition,
      size,
    );

    setState(() {
      _drawingStart = point;

      if (_activeDrawingTool == 'freehand' ||
          _activeDrawingTool == 'brush' ||
          _activeDrawingTool == 'path') {
        _draftDrawing = _ChartDrawing(
          kind: _activeDrawingTool,
          points: <Offset>[point],
        );
      } else {
        _draftDrawing = _ChartDrawing(
          kind: _activeDrawingTool,
          points: <Offset>[point, point],
        );
      }
    });
  }

  void _handleChartPanUpdate(
    DragUpdateDetails details,
    Size size,
  ) {
    if (!_drawingToolUsesDrag) {
      _chartPanDragRemainder += details.delta.dx;

      const pixelsPerCandle = 8.0;

      final steps = (_chartPanDragRemainder / pixelsPerCandle).truncate();

      if (steps != 0) {
        _chartPanDragRemainder -= steps * pixelsPerCandle;

        final all = candles;

        final visibleCount = math.min(
          _visibleCandleCount,
          all.length,
        );

        final maxOffset = math.max(
          0,
          all.length - visibleCount,
        );

        setState(() {
          _chartPanOffset = (_chartPanOffset + steps).clamp(
            0,
            maxOffset,
          );
        });
      }

      return;
    }

    if (_drawingStart == null) {
      return;
    }

    final point = _normalizeChartPoint(
      details.localPosition,
      size,
    );

    setState(() {
      if (_activeDrawingTool == 'freehand' ||
          _activeDrawingTool == 'brush' ||
          _activeDrawingTool == 'path') {
        final points = <Offset>[
          ...?_draftDrawing?.points,
          point,
        ];

        _draftDrawing = _ChartDrawing(
          kind: _activeDrawingTool,
          points: points,
        );
      } else {
        _draftDrawing = _ChartDrawing(
          kind: _activeDrawingTool,
          points: <Offset>[
            _drawingStart!,
            point,
          ],
        );
      }
    });
  }

  void _handleChartPanEnd(DragEndDetails details) {
    if (!_drawingToolUsesDrag) {
      _chartPanDragRemainder = 0.0;
      return;
    }

    final draft = _draftDrawing;

    if (draft == null) {
      return;
    }

    _commitDrawing(draft);
  }

