  List<double?> _ultimateOscillator(
    List<_OhlcCandle> source, {
    int shortPeriod = 7,
    int middlePeriod = 14,
    int longPeriod = 28,
  }) {
    final result = List<double?>.filled(source.length, null);

    if (source.length <= longPeriod) {
      return result;
    }

    final bp = List<double>.filled(source.length, 0);
    final tr = List<double>.filled(source.length, 0);

    for (int i = 1; i < source.length; i++) {
      final minLowClose = math.min(source[i].low, source[i - 1].close);

      final maxHighClose = math.max(source[i].high, source[i - 1].close);

      bp[i] = source[i].close - minLowClose;
      tr[i] = maxHighClose - minLowClose;
    }

    double averageAt(int index, int period) {
      double bpSum = 0;
      double trSum = 0;

      for (int j = index - period + 1; j <= index; j++) {
        bpSum += bp[j];
        trSum += tr[j];
      }

      return trSum == 0 ? 0 : bpSum / trSum;
    }

    for (int i = longPeriod; i < source.length; i++) {
      final shortAvg = averageAt(i, shortPeriod);
      final middleAvg = averageAt(i, middlePeriod);
      final longAvg = averageAt(i, longPeriod);

      result[i] = 100 * ((4 * shortAvg) + (2 * middleAvg) + longAvg) / 7;
    }

    return result;
  }

  Map<String, List<double?>> _aroon(
    List<_OhlcCandle> source,
    int period,
  ) {
    final up = List<double?>.filled(source.length, null);
    final down = List<double?>.filled(source.length, null);

    if (period <= 0 || source.length < period) {
      return {
        'up': up,
        'down': down,
      };
    }

    for (int i = period - 1; i < source.length; i++) {
      int highestIndex = i - period + 1;
      int lowestIndex = i - period + 1;

      for (int j = i - period + 1; j <= i; j++) {
        if (source[j].high >= source[highestIndex].high) {
          highestIndex = j;
        }

        if (source[j].low <= source[lowestIndex].low) {
          lowestIndex = j;
        }
      }

      final periodsSinceHigh = i - highestIndex;
      final periodsSinceLow = i - lowestIndex;

      up[i] = 100 * (period - periodsSinceHigh) / period;
      down[i] = 100 * (period - periodsSinceLow) / period;
    }

    return {
      'up': up,
      'down': down,
    };
  }

  List<double?> _trix(
    List<double> values,
    int period,
  ) {
    final ema1 = _ema(values, period);

    List<double> compactValues(List<double?> input) {
      return input
          .where((value) => value != null && value.isFinite)
          .map((value) => value!)
          .toList();
    }

    final ema2 = _ema(compactValues(ema1), period);
    final ema3 = _ema(compactValues(ema2), period);

    final result = List<double?>.filled(values.length, null);

    final validOriginalIndexes = <int>[];

    for (int i = 0; i < ema1.length; i++) {
      if (ema1[i] != null) {
        validOriginalIndexes.add(i);
      }
    }

    final thirdStart = math.max(0, validOriginalIndexes.length - ema3.length);

    for (int i = 1; i < ema3.length; i++) {
      final previous = ema3[i - 1];
      final current = ema3[i];

      if (previous == null || current == null || previous == 0) continue;

      final mapIndex = thirdStart + i;

      if (mapIndex >= 0 && mapIndex < validOriginalIndexes.length) {
        result[validOriginalIndexes[mapIndex]] =
            ((current - previous) / previous) * 100;
      }
    }

    return result;
  }

  List<double?> _dpo(
    List<double> values,
    int period,
  ) {
    final result = List<double?>.filled(values.length, null);

    if (period <= 0 || values.length < period) {
      return result;
    }

    final sma = _sma(values, period);
    final displacement = (period ~/ 2) + 1;

    for (int i = 0; i < values.length; i++) {
      final shifted = i - displacement;

      if (shifted >= 0 && sma[i] != null) {
        result[i] = values[shifted] - sma[i]!;
      }
    }

    return result;
  }

  List<double?> _fisherTransform(
    List<_OhlcCandle> source,
    int period,
  ) {
    final result = List<double?>.filled(source.length, null);

    if (period <= 1 || source.length < period) {
      return result;
    }

    double previousValue = 0;
    double previousFisher = 0;

    for (int i = period - 1; i < source.length; i++) {
      double highest = source[i - period + 1].high;
      double lowest = source[i - period + 1].low;

      for (int j = i - period + 1; j <= i; j++) {
        highest = math.max(highest, source[j].high);
        lowest = math.min(lowest, source[j].low);
      }

      final median = (source[i].high + source[i].low) / 2.0;
      final range = highest - lowest;

      if (range == 0) {
        result[i] = previousFisher;
        continue;
      }

      double value =
          0.66 * (((median - lowest) / range) - 0.5) + 0.67 * previousValue;

      value = value.clamp(-0.999, 0.999);

      final fisher =
          0.5 * math.log((1 + value) / (1 - value)) + 0.5 * previousFisher;

      result[i] = fisher;
      previousValue = value;
      previousFisher = fisher;
    }

    return result;
  }

  List<double?> _obv(
    List<_OhlcCandle> source,
  ) {
    final result = List<double?>.filled(source.length, null);

    if (source.isEmpty) {
      return result;
    }

    double obv = 0;
    result[0] = obv;

    for (int i = 1; i < source.length; i++) {
      // No true exchange volume is currently supplied by the
      // Pocket Option candle payload, so OBV uses directional
      // candle activity as a normalized proxy.
      final proxyVolume = (source[i].high - source[i].low).abs();

      if (source[i].close > source[i - 1].close) {
        obv += proxyVolume;
      } else if (source[i].close < source[i - 1].close) {
        obv -= proxyVolume;
      }

      result[i] = obv;
    }

    return result;
  }

