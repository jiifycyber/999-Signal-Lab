  List<_OhlcCandle> get _visibleChartCandles {
    final all = candles;

    if (all.isEmpty) {
      return const <_OhlcCandle>[];
    }

    final visibleCount = math.min(
      _visibleCandleCount,
      all.length,
    );

    final maxOffset = math.max(
      0,
      all.length - visibleCount,
    );

    final safeOffset = _chartPanOffset.clamp(
      0,
      maxOffset,
    );

    final end = all.length - safeOffset;
    final start = math.max(
      0,
      end - visibleCount,
    );

    return all.sublist(
      start,
      end,
    );
  }

