  Widget _chartWorkspace() {
    final active = _activeIndicators.where((item) => item.visible).toList();

    final closes = candles.map((candle) => candle.close).toList();

    List<double?> cciSeries(int period) {
      final safePeriod = period.clamp(1, 5000);
      final result = List<double?>.filled(candles.length, null);

      if (candles.length < safePeriod) {
        return result;
      }

      final typical = candles
          .map(
            (candle) => (candle.high + candle.low + candle.close) / 3.0,
          )
          .toList();

      for (int i = safePeriod - 1; i < typical.length; i++) {
        double sum = 0;

        for (int j = i - safePeriod + 1; j <= i; j++) {
          sum += typical[j];
        }

        final mean = sum / safePeriod;

        double deviation = 0;

        for (int j = i - safePeriod + 1; j <= i; j++) {
          deviation += (typical[j] - mean).abs();
        }

        deviation /= safePeriod;

        if (deviation != 0) {
          result[i] = (typical[i] - mean) / (0.015 * deviation);
        }
      }

      return result;
    }

    List<double?> williamsSeries(int period) {
      final safePeriod = period.clamp(1, 5000);
      final result = List<double?>.filled(candles.length, null);

      if (candles.length < safePeriod) {
        return result;
      }

      for (int i = safePeriod - 1; i < candles.length; i++) {
        double highest = candles[i].high;
        double lowest = candles[i].low;

        for (int j = i - safePeriod + 1; j <= i; j++) {
          highest = math.max(highest, candles[j].high);
          lowest = math.min(lowest, candles[j].low);
        }

        final range = highest - lowest;

        if (range != 0) {
          result[i] = ((highest - candles[i].close) / range) * -100.0;
        }
      }

      return result;
    }

    List<double?> mfiSeries(int period) {
      final safePeriod = period.clamp(1, 5000);
      final result = List<double?>.filled(candles.length, null);

      if (candles.length <= safePeriod) {
        return result;
      }

      for (int i = safePeriod; i < candles.length; i++) {
        double positive = 0;
        double negative = 0;

        final first = i - safePeriod + 1;

        for (int j = first; j <= i; j++) {
          if (j <= 0) {
            continue;
          }

          final current =
              (candles[j].high + candles[j].low + candles[j].close) / 3.0;

          final previous = (candles[j - 1].high +
                  candles[j - 1].low +
                  candles[j - 1].close) /
              3.0;

          final proxyVolume = math.max(
            (candles[j].high - candles[j].low).abs(),
            0.0000001,
          );

          final flow = current * proxyVolume;

          if (current >= previous) {
            positive += flow;
          } else {
            negative += flow;
          }
        }

        if (negative == 0) {
          result[i] = 100;
        } else {
          final ratio = positive / negative;
          result[i] = 100 - (100 / (1 + ratio));
        }
      }

      return result;
    }

    Map<String, List<double?>> adxSeries(int period) {
      final safePeriod = period.clamp(1, 5000);
      final count = candles.length;

      final adx = List<double?>.filled(count, null);
      final plusDi = List<double?>.filled(count, null);
      final minusDi = List<double?>.filled(count, null);

      if (count <= safePeriod) {
        return <String, List<double?>>{
          'adx': adx,
          'plus': plusDi,
          'minus': minusDi,
        };
      }

      final tr = List<double>.filled(count, 0);
      final plusDm = List<double>.filled(count, 0);
      final minusDm = List<double>.filled(count, 0);

      for (int i = 1; i < count; i++) {
        final upMove = candles[i].high - candles[i - 1].high;
        final downMove = candles[i - 1].low - candles[i].low;

        plusDm[i] = upMove > downMove && upMove > 0 ? upMove : 0.0;

        minusDm[i] = downMove > upMove && downMove > 0 ? downMove : 0.0;

        tr[i] = math.max(
          candles[i].high - candles[i].low,
          math.max(
            (candles[i].high - candles[i - 1].close).abs(),
            (candles[i].low - candles[i - 1].close).abs(),
          ),
        );
      }

      double smoothTr = 0;
      double smoothPlus = 0;
      double smoothMinus = 0;

      for (int i = 1; i <= safePeriod && i < count; i++) {
        smoothTr += tr[i];
        smoothPlus += plusDm[i];
        smoothMinus += minusDm[i];
      }

      final dx = List<double?>.filled(count, null);

      for (int i = safePeriod; i < count; i++) {
        if (i > safePeriod) {
          smoothTr = smoothTr - (smoothTr / safePeriod) + tr[i];

          smoothPlus = smoothPlus - (smoothPlus / safePeriod) + plusDm[i];

          smoothMinus = smoothMinus - (smoothMinus / safePeriod) + minusDm[i];
        }

        if (smoothTr == 0) {
          continue;
        }

        final plus = 100 * smoothPlus / smoothTr;
        final minus = 100 * smoothMinus / smoothTr;

        plusDi[i] = plus;
        minusDi[i] = minus;

        final total = plus + minus;

        if (total != 0) {
          dx[i] = 100 * (plus - minus).abs() / total;
        }
      }

      final validDx = <double>[];
      final validIndexes = <int>[];

      for (int i = 0; i < dx.length; i++) {
        final value = dx[i];

        if (value != null && value.isFinite) {
          validDx.add(value);
          validIndexes.add(i);
        }
      }

      if (validDx.length >= safePeriod) {
        double sum = 0;

        for (int i = 0; i < safePeriod; i++) {
          sum += validDx[i];
        }

        double currentAdx = sum / safePeriod;

        adx[validIndexes[safePeriod - 1]] = currentAdx;

        for (int i = safePeriod; i < validDx.length; i++) {
          currentAdx =
              ((currentAdx * (safePeriod - 1)) + validDx[i]) / safePeriod;

          adx[validIndexes[i]] = currentAdx;
        }
      }

      return <String, List<double?>>{
        'adx': adx,
        'plus': plusDi,
        'minus': minusDi,
      };
    }

