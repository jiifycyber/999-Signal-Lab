  Offset _normalizeChartPoint(
    Offset point,
    Size size,
  ) {
    final width = math.max(1.0, size.width);
    final height = math.max(1.0, size.height);

    return Offset(
      (point.dx / width).clamp(0.0, 1.0).toDouble(),
      (point.dy / height).clamp(0.0, 1.0).toDouble(),
    );
  }

  void _recordDrawingHistory() {
    _drawingUndoStack.add(
      List<_ChartDrawing>.from(_chartDrawings),
    );

    if (_drawingUndoStack.length > 100) {
      _drawingUndoStack.removeAt(0);
    }

    _drawingRedoStack.clear();
  }

  void _commitDrawing(_ChartDrawing drawing) {
    setState(() {
      _recordDrawingHistory();
      _chartDrawings.add(drawing);
      _draftDrawing = null;
      _drawingStart = null;
    });
  }

  void _undoDrawing() {
    if (_drawingUndoStack.isEmpty) {
      return;
    }

    setState(() {
      _drawingRedoStack.add(
        List<_ChartDrawing>.from(_chartDrawings),
      );

      final previous = _drawingUndoStack.removeLast();

      _chartDrawings
        ..clear()
        ..addAll(previous);

      _draftDrawing = null;
    });
  }

  void _redoDrawing() {
    if (_drawingRedoStack.isEmpty) {
      return;
    }

    setState(() {
      _drawingUndoStack.add(
        List<_ChartDrawing>.from(_chartDrawings),
      );

      final next = _drawingRedoStack.removeLast();

      _chartDrawings
        ..clear()
        ..addAll(next);

      _draftDrawing = null;
    });
  }

  void _deleteLastDrawing() {
    if (_chartDrawings.isEmpty) {
      return;
    }

    setState(() {
      _recordDrawingHistory();
      _chartDrawings.removeLast();
    });
  }

  void _clearAllDrawings() {
    if (_chartDrawings.isEmpty) {
      return;
    }

    setState(() {
      _recordDrawingHistory();
      _chartDrawings.clear();
      _draftDrawing = null;
    });
  }

