  List<double?> _deMarker(
    List<_OhlcCandle> source,
    int period,
  ) {
    final result = List<double?>.filled(source.length, null);

    if (source.length <= period || period <= 0) {
      return result;
    }

    final deMax = List<double>.filled(source.length, 0);
    final deMin = List<double>.filled(source.length, 0);

    for (int i = 1; i < source.length; i++) {
      deMax[i] = math.max(source[i].high - source[i - 1].high, 0);
      deMin[i] = math.max(source[i - 1].low - source[i].low, 0);
    }

    final maxSma = _sma(deMax, period);
    final minSma = _sma(deMin, period);

    for (int i = 0; i < source.length; i++) {
      final maxValue = maxSma[i];
      final minValue = minSma[i];

      if (maxValue == null || minValue == null) continue;

      final denominator = maxValue + minValue;

      result[i] = denominator == 0 ? 0.5 : maxValue / denominator;
    }

    return result;
  }

  Map<String, List<double?>> _stochasticRsi(
    List<double> values, {
    int rsiPeriod = 14,
    int stochasticPeriod = 14,
    int smoothK = 3,
    int smoothD = 3,
  }) {
    final rsi = _rsi(values, rsiPeriod);
    final raw = List<double?>.filled(values.length, null);

    for (int i = 0; i < rsi.length; i++) {
      if (i < stochasticPeriod - 1 || rsi[i] == null) continue;

      double? lowest;
      double? highest;
      bool valid = true;

      for (int j = i - stochasticPeriod + 1; j <= i; j++) {
        final value = rsi[j];

        if (value == null) {
          valid = false;
          break;
        }

        lowest = lowest == null ? value : math.min(lowest, value);
        highest = highest == null ? value : math.max(highest, value);
      }

      if (!valid || lowest == null || highest == null) continue;

      final range = highest - lowest;

      raw[i] = range == 0 ? 0 : ((rsi[i]! - lowest) / range) * 100;
    }

    List<double?> smoothNullable(List<double?> input, int period) {
      final output = List<double?>.filled(input.length, null);

      if (period <= 1) {
        return List<double?>.from(input);
      }

      for (int i = period - 1; i < input.length; i++) {
        double sum = 0;
        bool valid = true;

        for (int j = i - period + 1; j <= i; j++) {
          final value = input[j];

          if (value == null) {
            valid = false;
            break;
          }

          sum += value;
        }

        if (valid) {
          output[i] = sum / period;
        }
      }

      return output;
    }

    final k = smoothNullable(raw, math.max(1, smoothK));
    final d = smoothNullable(k, math.max(1, smoothD));

    return {
      'raw': raw,
