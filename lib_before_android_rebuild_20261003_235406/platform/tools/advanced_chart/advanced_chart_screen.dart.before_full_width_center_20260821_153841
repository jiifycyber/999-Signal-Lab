class _IndicatorPanePainter extends CustomPainter {
  final String title;
  final List<List<double?>> series;
  final List<Color> colors;
  final double? fixedMin;
  final double? fixedMax;
  final List<double> guides;
  final bool showZeroLine;

  const _IndicatorPanePainter({
    required this.title,
    required this.series,
    required this.colors,
    this.fixedMin,
    this.fixedMax,
    this.guides = const <double>[],
    this.showZeroLine = false,
  });

  @override
  void paint(Canvas canvas, Size size) {
    const left = 34.0;
    const right = 8.0;
    const top = 16.0;
    const bottom = 10.0;

    final width = math.max(
      1.0,
      size.width - left - right,
    );

    final height = math.max(
      1.0,
      size.height - top - bottom,
    );

    final finiteValues = <double>[];

    for (final values in series) {
      for (final value in values) {
        if (value != null && value.isFinite) {
          finiteValues.add(value);
        }
      }
    }

    final titlePainter = TextPainter(
      text: TextSpan(
        text: title,
        style: const TextStyle(
          color: Color(0xFF00E5FF),
          fontSize: 8,
          fontWeight: FontWeight.w900,
        ),
      ),
      maxLines: 1,
      ellipsis: '...',
      textDirection: TextDirection.ltr,
    )..layout(
        maxWidth: math.max(
          40.0,
          size.width * .58,
        ),
      );

    titlePainter.paint(
      canvas,
      const Offset(6, 3),
    );

    if (finiteValues.isEmpty) {
      return;
    }

    double minValue = fixedMin ?? finiteValues.reduce(math.min);

    double maxValue = fixedMax ?? finiteValues.reduce(math.max);

    for (final guide in guides) {
      minValue = math.min(minValue, guide);
      maxValue = math.max(maxValue, guide);
    }

    if (showZeroLine) {
      minValue = math.min(minValue, 0);
      maxValue = math.max(maxValue, 0);
    }

    if ((maxValue - minValue).abs() < 0.0000000001) {
      minValue -= 1;
      maxValue += 1;
    }

    final range = maxValue - minValue;

    double yFor(double value) {
      return top + height * (1 - ((value - minValue) / range));
    }

    final guidePaint = Paint()
      ..color = Colors.white.withValues(alpha: .12)
      ..strokeWidth = 1;

    for (final guide in guides) {
      if (guide < minValue || guide > maxValue) {
        continue;
      }

      final y = yFor(guide);

      canvas.drawLine(
        Offset(left, y),
        Offset(left + width, y),
        guidePaint,
      );

      final label = TextPainter(
        text: TextSpan(
          text: guide.toStringAsFixed(
            guide % 1 == 0 ? 0 : 1,
          ),
          style: const TextStyle(
            color: Colors.white38,
            fontSize: 7,
          ),
        ),
        textDirection: TextDirection.ltr,
      )..layout();

      label.paint(
        canvas,
        Offset(
          4,
          y - label.height / 2,
        ),
      );
    }

    if (showZeroLine && minValue <= 0 && maxValue >= 0) {
      final y = yFor(0);

      canvas.drawLine(
        Offset(left, y),
        Offset(left + width, y),
        Paint()
          ..color = Colors.white.withValues(alpha: .18)
          ..strokeWidth = 1,
      );
    }

    for (int seriesIndex = 0; seriesIndex < series.length; seriesIndex++) {
      final values = series[seriesIndex];

      if (values.isEmpty) {
        continue;
      }

      final color = colors.isEmpty
          ? const Color(0xFF00E5FF)
          : colors[seriesIndex % colors.length];

      final path = Path();
      bool started = false;

      final slot = values.length <= 1 ? width : width / (values.length - 1);

      for (int i = 0; i < values.length; i++) {
        final value = values[i];

        if (value == null || !value.isFinite) {
          started = false;
          continue;
        }

        final x = left + i * slot;
        final y = yFor(value);

        if (!started) {
          path.moveTo(x, y);
          started = true;
        } else {
          path.lineTo(x, y);
        }
      }

      canvas.drawPath(
        path,
        Paint()
          ..color = color
          ..strokeWidth = 1.55
          ..style = PaintingStyle.stroke
          ..strokeCap = StrokeCap.round,
      );
    }

    final latestLabels = <String>[];

    for (final values in series) {
      double? latest;

      for (int i = values.length - 1; i >= 0; i--) {
        final value = values[i];

        if (value != null && value.isFinite) {
          latest = value;
          break;
        }
      }

      if (latest != null) {
        latestLabels.add(
          latest.toStringAsFixed(
            latest.abs() >= 100 ? 1 : 2,
          ),
        );
      }
    }

    if (latestLabels.isNotEmpty) {
      final latestPainter = TextPainter(
        text: TextSpan(
          text: latestLabels.join(' / '),
          style: const TextStyle(
            color: Colors.white,
            fontSize: 8,
            fontWeight: FontWeight.w900,
          ),
        ),
        maxLines: 1,
        textDirection: TextDirection.ltr,
      )..layout(
          maxWidth: math.max(
            40.0,
            size.width * .38,
          ),
        );

      latestPainter.paint(
        canvas,
        Offset(
          math.max(
            left,
            size.width - latestPainter.width - 6,
          ),
          3,
        ),
      );
    }
  }

  @override
  bool shouldRepaint(
    covariant _IndicatorPanePainter oldDelegate,
  ) {
    return oldDelegate.title != title ||
        oldDelegate.series != series ||
        oldDelegate.colors != colors ||
        oldDelegate.fixedMin != fixedMin ||
        oldDelegate.fixedMax != fixedMax ||
        oldDelegate.guides != guides ||
        oldDelegate.showZeroLine != showZeroLine;
  }
}

class _RsiPainter extends CustomPainter {
  final List<double?> values;
  final int period;
  final double upperLevel;
  final double lowerLevel;

  const _RsiPainter({
    required this.values,
    required this.period,
    required this.upperLevel,
    required this.lowerLevel,
  });

  @override
  void paint(Canvas canvas, Size size) {
    const left = 34.0;
    const right = 8.0;
    const top = 16.0;
    const bottom = 10.0;

    final width = math.max(1.0, size.width - left - right);

    final height = math.max(1.0, size.height - top - bottom);

    final guidePaint = Paint()
      ..color = Colors.white.withValues(alpha: .12)
      ..strokeWidth = 1;

    double yFor(double value) {
      final clamped = value.clamp(0.0, 100.0);

      return top + height * (1 - clamped / 100);
    }

    final levels = <double>[
      upperLevel.clamp(0.0, 100.0),
      50,
      lowerLevel.clamp(0.0, 100.0),
    ];

    for (final level in levels) {
      final y = yFor(level);

      canvas.drawLine(
        Offset(left, y),
        Offset(left + width, y),
        guidePaint,
      );

      final label = TextPainter(
        text: TextSpan(
          text: level.toStringAsFixed(
            level % 1 == 0 ? 0 : 1,
          ),
          style: const TextStyle(
            color: Colors.white38,
            fontSize: 7,
          ),
        ),
        textDirection: TextDirection.ltr,
      )..layout();

      label.paint(
        canvas,
        Offset(
          5,
          y - label.height / 2,
        ),
      );
    }

    final title = TextPainter(
      text: TextSpan(
        text: 'RSI $period',
        style: const TextStyle(
          color: Color(0xFF00E5FF),
          fontSize: 8,
          fontWeight: FontWeight.w900,
        ),
      ),
      textDirection: TextDirection.ltr,
    )..layout();

    title.paint(
      canvas,
      const Offset(6, 3),
    );

    if (values.isEmpty) return;

    final path = Path();
    bool started = false;

    final slot = values.length <= 1 ? width : width / (values.length - 1);

    for (int i = 0; i < values.length; i++) {
      final value = values[i];

      if (value == null || !value.isFinite) {
        started = false;
        continue;
      }

      final x = left + i * slot;
      final y = yFor(value);

      if (!started) {
        path.moveTo(x, y);
        started = true;
      } else {
        path.lineTo(x, y);
      }
    }

    canvas.drawPath(
      path,
      Paint()
        ..color = const Color(0xFF00E5FF)
        ..strokeWidth = 1.6
        ..style = PaintingStyle.stroke
        ..strokeCap = StrokeCap.round,
    );

    double? last;

    for (int i = values.length - 1; i >= 0; i--) {
      final value = values[i];

      if (value != null && value.isFinite) {
        last = value;
        break;
      }
    }

    if (last != null) {
      final label = TextPainter(
        text: TextSpan(
          text: last.toStringAsFixed(1),
          style: const TextStyle(
            color: Colors.white,
            fontSize: 8,
            fontWeight: FontWeight.w900,
          ),
        ),
        textDirection: TextDirection.ltr,
      )..layout();

      label.paint(
        canvas,
        Offset(
          math.max(
            left,
            size.width - label.width - 6,
          ),
          3,
        ),
      );
    }
  }

  @override
  bool shouldRepaint(
    covariant _RsiPainter oldDelegate,
  ) {
    return oldDelegate.values != values ||
        oldDelegate.period != period ||
        oldDelegate.upperLevel != upperLevel ||
        oldDelegate.lowerLevel != lowerLevel;
  }
}

class _MacdPainter extends CustomPainter {
  final List<double?> macd;
  final List<double?> signal;
  final List<double?> histogram;

  final int fastPeriod;
  final int slowPeriod;
  final int signalPeriod;

  const _MacdPainter({
    required this.macd,
    required this.signal,
    required this.histogram,
    required this.fastPeriod,
    required this.slowPeriod,
    required this.signalPeriod,
  });

  @override
  void paint(Canvas canvas, Size size) {
    const left = 10.0;
    const right = 8.0;
    const top = 16.0;
    const bottom = 10.0;

    final width = math.max(1.0, size.width - left - right);

    final height = math.max(1.0, size.height - top - bottom);

    final all = <double>[];

    for (final series in <List<double?>>[
      macd,
      signal,
      histogram,
    ]) {
      for (final value in series) {
        if (value != null && value.isFinite) {
          all.add(value);
        }
      }
    }

    final title = TextPainter(
      text: TextSpan(
        text: 'MACD $fastPeriod • $slowPeriod • $signalPeriod',
        style: const TextStyle(
          color: Color(0xFFB388FF),
          fontSize: 8,
          fontWeight: FontWeight.w900,
        ),
      ),
      textDirection: TextDirection.ltr,
    )..layout();

    title.paint(
      canvas,
      const Offset(6, 3),
    );

    if (all.isEmpty) return;

    double minValue = all.reduce(math.min);
    double maxValue = all.reduce(math.max);

    if ((maxValue - minValue).abs() < 0.0000000001) {
      minValue -= 1;
      maxValue += 1;
    }

    final range = maxValue - minValue;

    double yFor(double value) {
      return top + height * (1 - ((value - minValue) / range));
    }

    final zeroY = minValue <= 0 && maxValue >= 0 ? yFor(0) : top + height / 2;

    final zeroPaint = Paint()
      ..color = Colors.white.withValues(alpha: .12)
      ..strokeWidth = 1;

    canvas.drawLine(
      Offset(left, zeroY),
      Offset(left + width, zeroY),
      zeroPaint,
    );

    final count = math.max(
      macd.length,
      math.max(
        signal.length,
        histogram.length,
      ),
    );

    if (count <= 1) return;

    final slot = width / (count - 1);

    final histPaintPositive = Paint()
      ..color = const Color(0xFF27FF88).withValues(alpha: .55)
      ..strokeWidth = 2;

    final histPaintNegative = Paint()
      ..color = const Color(0xFFFF4057).withValues(alpha: .55)
      ..strokeWidth = 2;

    for (int i = 0; i < histogram.length; i++) {
      final value = histogram[i];

      if (value == null || !value.isFinite) {
        continue;
      }

      final x = left + i * slot;
      final y = yFor(value);

      canvas.drawLine(
        Offset(x, zeroY),
        Offset(x, y),
        value >= 0 ? histPaintPositive : histPaintNegative,
      );
    }

    void drawLineSeries(
      List<double?> values,
      Color color,
    ) {
      final path = Path();
      bool started = false;

      for (int i = 0; i < values.length; i++) {
        final value = values[i];

        if (value == null || !value.isFinite) {
          started = false;
          continue;
        }

        final x = left + i * slot;
        final y = yFor(value);

        if (!started) {
          path.moveTo(x, y);
          started = true;
        } else {
          path.lineTo(x, y);
        }
      }

      canvas.drawPath(
        path,
        Paint()
          ..color = color
          ..strokeWidth = 1.5
          ..style = PaintingStyle.stroke
          ..strokeCap = StrokeCap.round,
      );
    }

    drawLineSeries(
      macd,
      const Color(0xFF00E5FF),
    );

    drawLineSeries(
      signal,
      const Color(0xFFFFC857),
    );
  }

  @override
  bool shouldRepaint(
    covariant _MacdPainter oldDelegate,
  ) {
    return oldDelegate.macd != macd ||
        oldDelegate.signal != signal ||
        oldDelegate.histogram != histogram ||
        oldDelegate.fastPeriod != fastPeriod ||
        oldDelegate.slowPeriod != slowPeriod ||
        oldDelegate.signalPeriod != signalPeriod;
  }
}

class _VolumeActivityPainter extends CustomPainter {
  final List<_OhlcCandle> candles;
  final int maLength;
  final int profileBins;
  final double spikeThreshold;
  final bool showProfile;

  const _VolumeActivityPainter({
    required this.candles,
    required this.maLength,
    required this.profileBins,
    required this.spikeThreshold,
    required this.showProfile,
  });

  @override
  void paint(Canvas canvas, Size size) {
    const green = Color(0xFF27FF88);
    const red = Color(0xFFFF4057);
    const cyan = Color(0xFF00E5FF);
    const amber = Color(0xFFFFD23F);

    final title = TextPainter(
      text: const TextSpan(
        text: 'MARKET ACTIVITY • POCKET-STYLE VOLUME',
        style: TextStyle(
          color: amber,
          fontSize: 8,
          fontWeight: FontWeight.w900,
        ),
      ),
      textDirection: TextDirection.ltr,
    )..layout();

    title.paint(canvas, const Offset(10, 5));

    if (candles.isEmpty) {
      final waiting = TextPainter(
        text: const TextSpan(
          text: 'WAITING FOR MARKET ACTIVITY...',
          style: TextStyle(
            color: Colors.white38,
            fontSize: 9,
            fontWeight: FontWeight.w700,
          ),
        ),
        textDirection: TextDirection.ltr,
      )..layout();

      waiting.paint(
        canvas,
        Offset(
          math.max(10.0, (size.width - waiting.width) / 2),
          size.height / 2,
        ),
      );
      return;
    }

    final lookback = math.min(
      math.max(4, maLength),
      candles.length,
    );

    final recent = candles.sublist(
      candles.length - lookback,
    );

    double totalActivity = 0;
    double totalBuy = 0;
    double totalSell = 0;

    for (final candle in recent) {
      final range = math.max(
        (candle.high - candle.low).abs(),
        0.0000001,
      );

      final body = (candle.close - candle.open).abs();

      final activity = range + body * .35;

      final closePosition =
          ((candle.close - candle.low) / range).clamp(0.0, 1.0);

      totalActivity += activity;
      totalBuy += activity * closePosition;
      totalSell += activity * (1.0 - closePosition);
    }

    final pressureTotal = math.max(
      0.0000001,
      totalBuy + totalSell,
    );

    final buyPct = (totalBuy / pressureTotal * 100.0).clamp(0.0, 100.0);

    final sellPct = (totalSell / pressureTotal * 100.0).clamp(0.0, 100.0);

    final latest = candles.last;

    final latestRange = math.max(
      (latest.high - latest.low).abs(),
      0.0000001,
    );

    final latestBody = (latest.close - latest.open).abs();

    final latestActivity = latestRange + latestBody * .35;

    final avgActivity = totalActivity / math.max(1, recent.length);

    final rvo = avgActivity > 0 ? latestActivity / avgActivity : 0.0;

    final activityPct = (rvo * 50.0).clamp(0.0, 100.0);

    final spikePct = spikeThreshold <= 0
        ? 0.0
        : (rvo / spikeThreshold * 100.0).clamp(0.0, 100.0);

    final isSpike = rvo >= spikeThreshold;

    final left = 12.0;
    final right = 12.0;

    final availableWidth = math.max(20.0, size.width - left - right);

    final top = 26.0;
    final bottom = 8.0;

    final availableHeight = math.max(20.0, size.height - top - bottom);

    final gap = 6.0;

    final rowHeight = math.max(
      13.0,
      (availableHeight - gap * 3) / 4,
    );

    void drawBar({
      required int row,
      required String label,
      required double value,
      required String display,
      required Color color,
    }) {
      final y = top + row * (rowHeight + gap);

      const labelWidth = 78.0;
      const valueWidth = 58.0;

      final trackLeft = left + labelWidth;
      final trackRight = size.width - right - valueWidth;

      final trackWidth = math.max(20.0, trackRight - trackLeft);

      final trackHeight = math.max(7.0, rowHeight * .48);

      final trackY = y + (rowHeight - trackHeight) / 2;

      final labelPainter = TextPainter(
        text: TextSpan(
          text: label,
          style: TextStyle(
            color: color,
            fontSize: 8,
            fontWeight: FontWeight.w900,
          ),
        ),
        textDirection: TextDirection.ltr,
      )..layout();

      labelPainter.paint(
        canvas,
        Offset(left, y + (rowHeight - labelPainter.height) / 2),
      );

      final trackRect = RRect.fromRectAndRadius(
        Rect.fromLTWH(
          trackLeft,
          trackY,
          trackWidth,
          trackHeight,
        ),
        Radius.circular(trackHeight / 2),
      );

      canvas.drawRRect(
        trackRect,
        Paint()..color = Colors.white.withValues(alpha: .08),
      );

      final fillWidth = trackWidth * (value.clamp(0.0, 100.0) / 100.0);

      if (fillWidth > 0) {
        final fillRect = RRect.fromRectAndRadius(
          Rect.fromLTWH(
            trackLeft,
            trackY,
            fillWidth,
            trackHeight,
          ),
          Radius.circular(trackHeight / 2),
        );

        canvas.drawRRect(
          fillRect,
          Paint()..color = color.withValues(alpha: .88),
        );
      }

      // Pocket-style segment dots.
      for (int i = 1; i < 10; i++) {
        final x = trackLeft + trackWidth * i / 10;

        canvas.drawCircle(
          Offset(x, trackY + trackHeight / 2),
          1.1,
          Paint()..color = Colors.black.withValues(alpha: .55),
        );
      }

      final valuePainter = TextPainter(
        text: TextSpan(
          text: display,
          style: TextStyle(
            color: color,
            fontSize: 8,
            fontWeight: FontWeight.w900,
          ),
        ),
        textDirection: TextDirection.ltr,
      )..layout();

      valuePainter.paint(
        canvas,
        Offset(
          size.width - right - valuePainter.width,
          y + (rowHeight - valuePainter.height) / 2,
        ),
      );
    }

    drawBar(
      row: 0,
      label: 'BUY',
      value: buyPct,
      display: '${buyPct.toStringAsFixed(0)}%',
      color: green,
    );

    drawBar(
      row: 1,
      label: 'SELL',
      value: sellPct,
      display: '${sellPct.toStringAsFixed(0)}%',
      color: red,
    );

    drawBar(
      row: 2,
      label: 'ACTIVITY',
      value: activityPct,
      display: '${rvo.toStringAsFixed(2)}x',
      color: cyan,
    );

    drawBar(
      row: 3,
      label: 'SPIKE',
      value: spikePct,
      display: isSpike ? 'ACTIVE' : 'NORMAL',
      color: isSpike ? amber : Colors.white54,
    );
  }

  @override
  bool shouldRepaint(
    covariant _VolumeActivityPainter oldDelegate,
  ) {
    return oldDelegate.candles != candles ||
        oldDelegate.maLength != maLength ||
        oldDelegate.profileBins != profileBins ||
        oldDelegate.spikeThreshold != spikeThreshold ||
        oldDelegate.showProfile != showProfile;
  }
}

class _ChartDrawing {
  final String kind;
  final List<Offset> points;
  final String? text;

  const _ChartDrawing({
    required this.kind,
    required this.points,
    this.text,
  });
}

class _ChartDrawingPainter extends CustomPainter {
  final List<_ChartDrawing> drawings;
  final _ChartDrawing? draft;
  final Offset? crosshairPosition;
  final bool showCrosshair;

  const _ChartDrawingPainter({
    required this.drawings,
    this.draft,
    this.crosshairPosition,
    this.showCrosshair = false,
  });

  Offset pointFor(
    Offset normalized,
    Size size,
  ) {
    return Offset(
      normalized.dx * size.width,
      normalized.dy * size.height,
    );
  }

  @override
  void paint(Canvas canvas, Size size) {
    final normalPaint = Paint()
      ..color = const Color(0xFFEAF2F8)
      ..strokeWidth = 1.4
      ..style = PaintingStyle.stroke;

    final cyanPaint = Paint()
      ..color = const Color(0xFF00E5FF)
      ..strokeWidth = 1.4
      ..style = PaintingStyle.stroke;

    final fillPaint = Paint()
      ..color = const Color(0xFF00E5FF).withValues(alpha: .08)
      ..style = PaintingStyle.fill;

    void drawOne(
      _ChartDrawing drawing, {
      bool preview = false,
    }) {
      if (drawing.points.isEmpty) {
        return;
      }

      final paint = preview ? cyanPaint : normalPaint;

      final points =
          drawing.points.map((point) => pointFor(point, size)).toList();

      switch (drawing.kind) {
        case 'horizontal':
          final y = points.first.dy;

          canvas.drawLine(
            Offset(0, y),
            Offset(size.width, y),
            paint,
          );
          break;

        case 'vertical':
          final x = points.first.dx;

          canvas.drawLine(
            Offset(x, 0),
            Offset(x, size.height),
            paint,
          );
          break;

        case 'trend':
        case 'measure':
          if (points.length < 2) {
            return;
          }

          canvas.drawLine(
            points.first,
            points.last,
            paint,
          );

          if (drawing.kind == 'measure') {
            final dx = (points.last.dx - points.first.dx).abs();
            final dy = (points.last.dy - points.first.dy).abs();

            final painter = TextPainter(
              text: TextSpan(
                text:
                    'ΔX ${dx.toStringAsFixed(0)}  ΔY ${dy.toStringAsFixed(0)}',
                style: const TextStyle(
                  color: Color(0xFFFFC857),
                  fontSize: 9,
                  fontWeight: FontWeight.w800,
                ),
              ),
              textDirection: TextDirection.ltr,
            )..layout();

            painter.paint(
              canvas,
              points.last + const Offset(6, -16),
            );
          }
          break;

        case 'ray':
          if (points.length < 2) {
            return;
          }

          final a = points.first;
          final b = points.last;
          final delta = b - a;

          if (delta.distance < 1) {
            return;
          }

          final scale = size.longestSide * 3;

          final direction = delta / delta.distance;

          canvas.drawLine(
            a,
            a + direction * scale,
            paint,
          );
          break;

        case 'rect':
          if (points.length < 2) {
            return;
          }

          final rect = Rect.fromPoints(
            points.first,
            points.last,
          );

          canvas.drawRect(rect, fillPaint);
          canvas.drawRect(rect, paint);
          break;

        case 'fib':
          if (points.length < 2) {
            return;
          }

          final a = points.first;
          final b = points.last;

          final left = math.min(a.dx, b.dx);
          final right = math.max(a.dx, b.dx);
          final top = a.dy;
          final bottom = b.dy;

          const levels = <double>[
            0.0,
            0.236,
            0.382,
            0.5,
            0.618,
            0.786,
            1.0,
          ];

          for (final level in levels) {
            final y = top + (bottom - top) * level;

            canvas.drawLine(
              Offset(left, y),
              Offset(right, y),
              paint,
            );

            final label = TextPainter(
              text: TextSpan(
                text: level.toStringAsFixed(3),
                style: const TextStyle(
                  color: Color(0xFF00E5FF),
                  fontSize: 8,
                ),
              ),
              textDirection: TextDirection.ltr,
            )..layout();

            label.paint(
              canvas,
              Offset(right + 4, y - 5),
            );
          }
          break;

        case 'freehand':
        case 'brush':
        case 'path':
          if (points.length < 2) {
            return;
          }

          final path = Path()
            ..moveTo(
              points.first.dx,
              points.first.dy,
            );

          for (final point in points.skip(1)) {
            path.lineTo(
              point.dx,
              point.dy,
            );
          }

          canvas.drawPath(path, paint);
          break;

        case 'text':
          final painter = TextPainter(
            text: TextSpan(
              text: drawing.text ?? 'TEXT',
              style: const TextStyle(
                color: Color(0xFFEAF2F8),
                fontSize: 12,
                fontWeight: FontWeight.w800,
              ),
            ),
            textDirection: TextDirection.ltr,
          )..layout();

          painter.paint(
            canvas,
            points.first,
          );
          break;
      }
    }

    for (final drawing in drawings) {
      drawOne(drawing);
    }

    if (draft != null) {
      drawOne(
        draft!,
        preview: true,
      );
    }

    if (showCrosshair && crosshairPosition != null) {
      final point = pointFor(
        crosshairPosition!,
        size,
      );

      final crossPaint = Paint()
        ..color = const Color(0xFFFFFFFF).withValues(alpha: .32)
        ..strokeWidth = 1;

      canvas.drawLine(
        Offset(point.dx, 0),
        Offset(point.dx, size.height),
        crossPaint,
      );

      canvas.drawLine(
        Offset(0, point.dy),
        Offset(size.width, point.dy),
        crossPaint,
      );
    }
  }

  @override
  bool shouldRepaint(
    covariant _ChartDrawingPainter oldDelegate,
  ) {
    return true;
  }
}

class _CandlestickPainter extends CustomPainter {
  final List<_OhlcCandle> candles;
  final double currentPrice;
  final bool showGrid;
  final double zoom;
  final List<_IndicatorConfig> indicators;
  final String chartType;

  const _CandlestickPainter({
    required this.candles,
    required this.currentPrice,
    required this.showGrid,
    required this.zoom,
    required this.indicators,
    this.chartType = 'Candles',
  });

  @override
  void paint(Canvas canvas, Size size) {
    const leftPad = 14.0;
    const rightPad = 68.0;
    const topPad = 24.0;
    const bottomPad = 28.0;

    final chartWidth = math.max(1.0, size.width - leftPad - rightPad);

    final chartHeight = math.max(1.0, size.height - topPad - bottomPad);

    if (showGrid) {
      final gridPaint = Paint()
        ..color = Colors.white.withValues(alpha: .030)
        ..strokeWidth = .75;

      final majorGridPaint = Paint()
        ..color = Colors.white.withValues(alpha: .052)
        ..strokeWidth = .85;

      for (int i = 0; i <= 8; i++) {
        final x = leftPad + chartWidth * i / 8;

        canvas.drawLine(
          Offset(x, topPad),
          Offset(x, topPad + chartHeight),
          i == 0 || i == 8 ? majorGridPaint : gridPaint,
        );
      }

      for (int i = 0; i <= 6; i++) {
        final y = topPad + chartHeight * i / 6;

        canvas.drawLine(
          Offset(leftPad, y),
          Offset(leftPad + chartWidth, y),
          i == 0 || i == 6 ? majorGridPaint : gridPaint,
        );
      }
    }

    if (candles.isEmpty) {
      return;
    }

    // ------------------------------------------------------
    // CHART TYPE DISPLAY SERIES
    // ------------------------------------------------------
    //
    // Candles, Bars and Line use the real OHLC series directly.
    // Heikin Ashi is calculated from the same real OHLC data and does
    // not replace or modify stored market prices.
    final displayCandles = <_OhlcCandle>[];

    if (chartType == 'Heikin Ashi') {
      double? previousHaOpen;
      double? previousHaClose;

      for (final candle in candles) {
        final haClose =
            (candle.open + candle.high + candle.low + candle.close) / 4.0;

        final haOpen = previousHaOpen == null || previousHaClose == null
            ? (candle.open + candle.close) / 2.0
            : (previousHaOpen + previousHaClose) / 2.0;

        final haHigh = math.max(
          candle.high,
          math.max(haOpen, haClose),
        );

        final haLow = math.min(
          candle.low,
          math.min(haOpen, haClose),
        );

        displayCandles.add(
          _OhlcCandle(
            bucket: candle.bucket,
            open: haOpen,
            high: haHigh,
            low: haLow,
            close: haClose,
          ),
        );

        previousHaOpen = haOpen;
        previousHaClose = haClose;
      }
    } else {
      displayCandles.addAll(candles);
    }

    // Pocket Option-style vertical autoscaling.
    //
    // Scale from recent valid candles instead of allowing one malformed
    // historical OHLC value to flatten the entire chart.
    // Autoscale from the complete professional visible viewport.
    //
    // The chart already receives a maximum of 60 cleaned candles, so using
    // the full visible set keeps price scaling synchronized with everything
    // the trader can actually see.
    final scaleCandles = displayCandles;

    final closeValues = scaleCandles
        .map((candle) => candle.close)
        .where((value) => value.isFinite && value > 0)
        .toList()
      ..sort();

    final centerReference = closeValues.isNotEmpty
        ? closeValues[closeValues.length ~/ 2]
        : currentPrice;

    // Forex safety envelope. Reject chart-only OHLC outliers farther than
    // 5% from the recent median. This does NOT modify stored market data.
    final lowerValid =
        centerReference > 0 ? centerReference * 0.95 : double.negativeInfinity;

    final upperValid =
        centerReference > 0 ? centerReference * 1.05 : double.infinity;

    final validCandles = scaleCandles.where((candle) {
      return candle.open.isFinite &&
          candle.high.isFinite &&
          candle.low.isFinite &&
          candle.close.isFinite &&
          candle.open > 0 &&
          candle.high > 0 &&
          candle.low > 0 &&
          candle.close > 0 &&
          candle.open >= lowerValid &&
          candle.open <= upperValid &&
          candle.high >= lowerValid &&
          candle.high <= upperValid &&
          candle.low >= lowerValid &&
          candle.low <= upperValid &&
          candle.close >= lowerValid &&
          candle.close <= upperValid;
    }).toList();

    final scaleSource = validCandles.length >= 2 ? validCandles : scaleCandles;

    double low = scaleSource.first.low;
    double high = scaleSource.first.high;

    for (final candle in scaleSource) {
      if (candle.low < low) low = candle.low;
      if (candle.high > high) high = candle.high;
    }

    if (currentPrice.isFinite &&
        currentPrice > 0 &&
        currentPrice >= lowerValid &&
        currentPrice <= upperValid) {
      if (currentPrice < low) low = currentPrice;
      if (currentPrice > high) high = currentPrice;
    }

    var range = high - low;

    if (range.abs() < 0.0000001) {
      final center = currentPrice > 0 ? currentPrice : high;
      final padding = math.max(center.abs() * 0.00015, 0.00005);

      low = center - padding;
      high = center + padding;
      range = high - low;
    } else {
      // A little breathing room above/below the visible movement.
      final padding = range * 0.10;
      low -= padding;
      high += padding;
      range = high - low;
    }

    // Additional professional visible-range breathing room.
    //
    // The existing autoscale removes malformed outliers. This small margin
    // prevents valid candles from touching the top and bottom plot edges.
    if (range > 0) {
      final viewportMargin = range * .04;
      low -= viewportMargin;
      high += viewportMargin;
      range = high - low;
    }

    // Manual vertical zoom.
    //
    // 1.0 = AUTO
    // Higher values magnify the real candle movement around the center.
    if (zoom > 1.0 && range > 0) {
      final center = (high + low) / 2.0;
      final zoomedRange = range / zoom;

      low = center - zoomedRange / 2.0;
      high = center + zoomedRange / 2.0;
      range = high - low;
    }

    double yFor(double price) {
      final normalized = (price - low) / range;

      return topPad + chartHeight * (1.0 - normalized);
    }

    final count = displayCandles.length;

    // Professional fixed bar-spacing model.
    //
    // Sparse history must NOT stretch itself across the entire chart.
    // Around 8 px per slot gives a dense Pocket-style normal zoom while
    // automatically shrinking only when the viewport physically requires it.
    final fittedSlotWidth = chartWidth / math.max(1.0, count + 1.25);

    final slotWidth = math.min(
      8.0,
      fittedSlotWidth,
    );

    // Candle body occupies most of the horizontal slot.
    // At the normal 8 px spacing this produces roughly:
    //   body = 6.56 px
    //   gap  = 1.44 px
    final bodyWidth = math.max(
      2.5,
      slotWidth * .82,
    );

    final usedWidth = slotWidth * count;
    final rightBreathingRoom = slotWidth * 1.25;

    final startX = leftPad +
        math.max(
          0.0,
          chartWidth - usedWidth - rightBreathingRoom,
        );

    // Integrated market-activity underlay.
    //
    // Pocket Option history currently supplies OHLC without verified volume.
    // We therefore visualize candle activity from true OHLC movement instead
    // of presenting synthetic values as exchange volume.
    if (count > 1) {
      final activityValues = displayCandles
          .map(
            (candle) =>
                (candle.high - candle.low).abs() +
                (candle.close - candle.open).abs(),
          )
          .toList();

      final maxActivity = activityValues.reduce(math.max);

      if (maxActivity > 0) {
        final activityHeight = chartHeight * .15;
        final activityBottom = topPad + chartHeight;

        final activityLabel = TextPainter(
          text: TextSpan(
            text: 'MARKET ACTIVITY',
            style: TextStyle(
              color: Colors.white.withValues(alpha: .24),
              fontSize: 6.5,
              fontWeight: FontWeight.w700,
              letterSpacing: .5,
            ),
          ),
          textDirection: TextDirection.ltr,
        )..layout();

        activityLabel.paint(
          canvas,
          Offset(
            leftPad + 4,
            activityBottom - activityHeight - 12,
          ),
        );

        for (int i = 0; i < count; i++) {
          final candle = displayCandles[i];
          final x = startX + slotWidth * i + slotWidth / 2;
          final bullish = candle.close >= candle.open;

          final normalized = (activityValues[i] / maxActivity).clamp(0.0, 1.0);

          final barHeight = math.max(
            1.0,
            activityHeight * normalized,
          );

          final activityPaint = Paint()
            ..color =
                (bullish ? const Color(0xFF27FF88) : const Color(0xFFFF4057))
                    .withValues(alpha: .16)
            ..style = PaintingStyle.fill;

          canvas.drawRRect(
            RRect.fromRectAndRadius(
              Rect.fromLTWH(
                x - bodyWidth * .38,
                activityBottom - barHeight,
                bodyWidth * .76,
                barHeight,
              ),
              const Radius.circular(1),
            ),
            activityPaint,
          );
        }
      }
    }

    for (int i = 0; i < count; i++) {
      final candle = displayCandles[i];

      final x = startX + slotWidth * i + slotWidth / 2;

      final bullish = candle.close >= candle.open;

      final color = bullish ? const Color(0xFF27FF88) : const Color(0xFFFF4057);

      final highY = yFor(candle.high);
      final lowY = yFor(candle.low);
      final openY = yFor(candle.open);
      final closeY = yFor(candle.close);

      // ----------------------------------------------------
      // LINE
      // ----------------------------------------------------
      if (chartType == 'Line') {
        if (i > 0) {
          final previous = displayCandles[i - 1];

          final previousX = startX + slotWidth * (i - 1) + slotWidth / 2;

          final linePaint = Paint()
            ..color = const Color(0xFF00E5FF)
            ..strokeWidth = 1.8
            ..strokeCap = StrokeCap.round
            ..isAntiAlias = true;

          canvas.drawLine(
            Offset(
              previousX,
              yFor(previous.close),
            ),
            Offset(
              x,
              closeY,
            ),
            linePaint,
          );
        }

        continue;
      }

      final wickPaint = Paint()
        ..color = color.withValues(alpha: .96)
        ..strokeWidth = math.max(
          1.0,
          math.min(1.5, bodyWidth * .14),
        )
        ..strokeCap = StrokeCap.round;

      // ----------------------------------------------------
      // OHLC BARS
      // ----------------------------------------------------
      if (chartType == 'Bars') {
        canvas.drawLine(
          Offset(x, highY),
          Offset(x, lowY),
          wickPaint,
        );

        final tickWidth = math.max(
          2.0,
          bodyWidth * .48,
        );

        canvas.drawLine(
          Offset(x - tickWidth, openY),
          Offset(x, openY),
          wickPaint,
        );

        canvas.drawLine(
          Offset(x, closeY),
          Offset(x + tickWidth, closeY),
          wickPaint,
        );

        continue;
      }

      // ----------------------------------------------------
      // CANDLES + HEIKIN ASHI
      // ----------------------------------------------------
      //
      // Heikin Ashi reaches this block with its derived OHLC series.
      final bodyPaint = Paint()
        ..color = color
        ..style = PaintingStyle.fill
        ..isAntiAlias = true;

      canvas.drawLine(
        Offset(x, highY),
        Offset(x, lowY),
        wickPaint,
      );

      final top = math.min(openY, closeY);
      final bottom = math.max(openY, closeY);

      final bodyHeight = math.max(
        2.4,
        bottom - top,
      );

      canvas.drawRect(
        Rect.fromLTWH(
          x - bodyWidth / 2,
          top,
          bodyWidth,
          bodyHeight,
        ),
        bodyPaint,
      );
    }

    // ========================================================
    // CONFIGURABLE TECHNICAL INDICATOR OVERLAYS
    // ========================================================

    List<double> sourceValues(_IndicatorSource source) {
      return candles.map((candle) {
        switch (source) {
          case _IndicatorSource.open:
            return candle.open;
          case _IndicatorSource.high:
            return candle.high;
          case _IndicatorSource.low:
            return candle.low;
          case _IndicatorSource.hl2:
            return (candle.high + candle.low) / 2.0;
          case _IndicatorSource.hlc3:
            return (candle.high + candle.low + candle.close) / 3.0;
          case _IndicatorSource.ohlc4:
            return (candle.open + candle.high + candle.low + candle.close) /
                4.0;
          case _IndicatorSource.close:
            return candle.close;
        }
      }).toList();
    }

    List<double?> smaSeries(List<double> values, int period) {
      final result = List<double?>.filled(values.length, null);

      if (period <= 0 || values.length < period) {
        return result;
      }

      double sum = 0;

      for (int i = 0; i < values.length; i++) {
        sum += values[i];

        if (i >= period) {
          sum -= values[i - period];
        }

        if (i >= period - 1) {
          result[i] = sum / period;
        }
      }

      return result;
    }

    List<double?> emaSeries(List<double> values, int period) {
      final result = List<double?>.filled(values.length, null);

      if (values.isEmpty || period <= 0) {
        return result;
      }

      final multiplier = 2.0 / (period + 1.0);
      double value = values.first;

      result[0] = value;

      for (int i = 1; i < values.length; i++) {
        value = ((values[i] - value) * multiplier) + value;
        result[i] = value;
      }

      return result;
    }

    List<double?> wmaSeries(List<double> values, int period) {
      final result = List<double?>.filled(values.length, null);

      if (period <= 0 || values.length < period) {
        return result;
      }

      final denominator = period * (period + 1) / 2.0;

      for (int i = period - 1; i < values.length; i++) {
        double weighted = 0;

        for (int j = 0; j < period; j++) {
          weighted += values[i - period + 1 + j] * (j + 1);
        }

        result[i] = weighted / denominator;
      }

      return result;
    }

    List<double?> rmaSeries(
      List<double> values,
      int period,
    ) {
      final result = List<double?>.filled(values.length, null);

      if (period <= 0 || values.length < period) {
        return result;
      }

      double seed = 0;

      for (int i = 0; i < period; i++) {
        seed += values[i];
      }

      double value = seed / period;
      result[period - 1] = value;

      for (int i = period; i < values.length; i++) {
        value = ((value * (period - 1)) + values[i]) / period;
        result[i] = value;
      }

      return result;
    }

    List<double?> demaSeries(
      List<double> values,
      int period,
    ) {
      final first = emaSeries(values, period);
      final compact = <double>[];
      final indexes = <int>[];

      for (int i = 0; i < first.length; i++) {
        final value = first[i];

        if (value != null && value.isFinite) {
          compact.add(value);
          indexes.add(i);
        }
      }

      final result = List<double?>.filled(values.length, null);

      if (compact.isEmpty) return result;

      final second = emaSeries(compact, period);

      for (int i = 0; i < second.length; i++) {
        final e1 = compact[i];
        final e2 = second[i];

        if (e2 != null) {
          result[indexes[i]] = 2 * e1 - e2;
        }
      }

      return result;
    }

    List<double?> temaSeries(
      List<double> values,
      int period,
    ) {
      final e1 = emaSeries(values, period);

      final compact1 = <double>[];
      final index1 = <int>[];

      for (int i = 0; i < e1.length; i++) {
        final value = e1[i];

        if (value != null) {
          compact1.add(value);
          index1.add(i);
        }
      }

      final result = List<double?>.filled(values.length, null);

      if (compact1.isEmpty) return result;

      final e2 = emaSeries(compact1, period);

      final compact2 = <double>[];
      final index2 = <int>[];

      for (int i = 0; i < e2.length; i++) {
        final value = e2[i];

        if (value != null) {
          compact2.add(value);
          index2.add(i);
        }
      }

      if (compact2.isEmpty) return result;

      final e3 = emaSeries(compact2, period);

      for (int i = 0; i < e3.length; i++) {
        final third = e3[i];

        if (third == null) continue;

        final secondCompactIndex = index2[i];
        final originalIndex = index1[secondCompactIndex];

        final firstValue = e1[originalIndex];
        final secondValue = e2[secondCompactIndex];

        if (firstValue != null && secondValue != null) {
          result[originalIndex] = 3 * firstValue - 3 * secondValue + third;
        }
      }

      return result;
    }

    List<double?> hmaSeries(
      List<double> values,
      int period,
    ) {
      final safePeriod = math.max(1, period);
      final half = math.max(1, safePeriod ~/ 2);
      final root = math.max(1, math.sqrt(safePeriod.toDouble()).round());

      final full = wmaSeries(values, safePeriod);
      final short = wmaSeries(values, half);

      final diff = List<double?>.filled(values.length, null);

      for (int i = 0; i < values.length; i++) {
        final a = short[i];
        final b = full[i];

        if (a != null && b != null) {
          diff[i] = 2 * a - b;
        }
      }

      final compact = <double>[];
      final indexes = <int>[];

      for (int i = 0; i < diff.length; i++) {
        final value = diff[i];

        if (value != null) {
          compact.add(value);
          indexes.add(i);
        }
      }

      final result = List<double?>.filled(values.length, null);

      if (compact.length < root) return result;

      final finalWma = wmaSeries(compact, root);

      for (int i = 0; i < finalWma.length; i++) {
        final value = finalWma[i];

        if (value != null) {
          result[indexes[i]] = value;
        }
      }

      return result;
    }

    List<double?> kamaSeries(
      List<double> values,
      int period,
    ) {
      final result = List<double?>.filled(values.length, null);
      final safePeriod = math.max(1, period);

      if (values.length <= safePeriod) return result;

      final fast = 2.0 / 3.0;
      final slow = 2.0 / 31.0;

      double kama = values[safePeriod];
      result[safePeriod] = kama;

      for (int i = safePeriod + 1; i < values.length; i++) {
        final change = (values[i] - values[i - safePeriod]).abs();

        double volatility = 0;

        for (int j = i - safePeriod + 1; j <= i; j++) {
          volatility += (values[j] - values[j - 1]).abs();
        }

        final efficiency = volatility == 0 ? 0.0 : change / volatility;

        final smoothing = math
            .pow(
              efficiency * (fast - slow) + slow,
              2,
            )
            .toDouble();

        kama += smoothing * (values[i] - kama);
        result[i] = kama;
      }

      return result;
    }

    List<double?> atrSeries(int period) {
      final result = List<double?>.filled(candles.length, null);

      if (candles.length <= period || period <= 0) {
        return result;
      }

      final tr = List<double>.filled(candles.length, 0);

      for (int i = 1; i < candles.length; i++) {
        tr[i] = math.max(
          candles[i].high - candles[i].low,
          math.max(
            (candles[i].high - candles[i - 1].close).abs(),
            (candles[i].low - candles[i - 1].close).abs(),
          ),
        );
      }

      double seed = 0;

      for (int i = 1; i <= period; i++) {
        seed += tr[i];
      }

      double atr = seed / period;
      result[period] = atr;

      for (int i = period + 1; i < candles.length; i++) {
        atr = ((atr * (period - 1)) + tr[i]) / period;
        result[i] = atr;
      }

      return result;
    }

    void drawSeries(
      List<double?> values,
      Color color, {
      double strokeWidth = 1.5,
    }) {
      final path = Path();
      bool started = false;

      for (int i = 0; i < values.length; i++) {
        final value = values[i];

        if (value == null || !value.isFinite || value < low || value > high) {
          started = false;
          continue;
        }

        final x = startX + slotWidth * i + slotWidth / 2;
        final y = yFor(value);

        if (!started) {
          path.moveTo(x, y);
          started = true;
        } else {
          path.lineTo(x, y);
        }
      }

      canvas.drawPath(
        path,
        Paint()
          ..color = color
          ..strokeWidth = strokeWidth
          ..style = PaintingStyle.stroke
          ..strokeCap = StrokeCap.round,
      );
    }

    const palette = <Color>[
      Color(0xFF00E5FF),
      Color(0xFFFFC857),
      Color(0xFFFF4FD8),
      Color(0xFFB388FF),
      Color(0xFFFF8A65),
      Color(0xFF8BC34A),
      Color(0xFF5C9DFF),
      Color(0xFFFFD740),
    ];

    int overlayIndex = 0;

    for (final indicator in indicators) {
      if (!indicator.visible) continue;

      final values = sourceValues(indicator.source);
      final color = palette[overlayIndex % palette.length];
      overlayIndex++;

      if (indicator.type == 'Moving Average') {
        drawSeries(
          smaSeries(values, indicator.length),
          color,
          strokeWidth: indicator.lineWidth,
        );
        continue;
      }

      if (indicator.type == 'Exponential Moving Average') {
        drawSeries(
          emaSeries(values, indicator.length),
          color,
          strokeWidth: indicator.lineWidth,
        );
        continue;
      }

      if (indicator.type == 'Weighted Moving Average') {
        drawSeries(
          wmaSeries(values, indicator.length),
          color,
          strokeWidth: indicator.lineWidth,
        );
        continue;
      }

      if (indicator.type == 'Smoothed Moving Average') {
        drawSeries(
          rmaSeries(values, indicator.length),
          color,
          strokeWidth: indicator.lineWidth,
        );
        continue;
      }

      if (indicator.type == 'Double Exponential Moving Average') {
        drawSeries(
          demaSeries(values, indicator.length),
          color,
          strokeWidth: indicator.lineWidth,
        );
        continue;
      }

      if (indicator.type == 'Triple Exponential Moving Average') {
        drawSeries(
          temaSeries(values, indicator.length),
          color,
          strokeWidth: indicator.lineWidth,
        );
        continue;
      }

      if (indicator.type == 'Hull Moving Average') {
        drawSeries(
          hmaSeries(values, indicator.length),
          color,
          strokeWidth: indicator.lineWidth,
        );
        continue;
      }

      if (indicator.type == 'Kaufman Adaptive Moving Average') {
        drawSeries(
          kamaSeries(values, indicator.length),
          color,
          strokeWidth: indicator.lineWidth,
        );
        continue;
      }

      if (indicator.type == 'Envelopes' &&
          indicator.length > 0 &&
          values.length >= indicator.length) {
        final basis = smaSeries(values, indicator.length);

        final upper = List<double?>.filled(values.length, null);

        final lower = List<double?>.filled(values.length, null);

        final deviation = indicator.value1 == 0 ? 0.1 : indicator.value1.abs();

        for (int i = 0; i < basis.length; i++) {
          final middle = basis[i];

          if (middle == null) continue;

          upper[i] = middle * (1 + deviation / 100.0);

          lower[i] = middle * (1 - deviation / 100.0);
        }

        drawSeries(
          upper,
          color,
          strokeWidth: indicator.lineWidth,
        );

        drawSeries(
          basis,
          color.withValues(alpha: .60),
          strokeWidth: 1.0,
        );

        drawSeries(
          lower,
          color,
          strokeWidth: indicator.lineWidth,
        );

        continue;
      }

      if (indicator.type == 'Donchian Channels') {
        final period = math.max(1, indicator.length);

        final upper = List<double?>.filled(candles.length, null);

        final lower = List<double?>.filled(candles.length, null);

        final middle = List<double?>.filled(candles.length, null);

        for (int i = period - 1; i < candles.length; i++) {
          double highest = candles[i - period + 1].high;

          double lowest = candles[i - period + 1].low;

          for (int j = i - period + 1; j <= i; j++) {
            highest = math.max(
              highest,
              candles[j].high,
            );

            lowest = math.min(
              lowest,
              candles[j].low,
            );
          }

          upper[i] = highest;
          lower[i] = lowest;
          middle[i] = (highest + lowest) / 2.0;
        }

        drawSeries(
          upper,
          color,
          strokeWidth: indicator.lineWidth,
        );

        drawSeries(
          middle,
          color.withValues(alpha: .60),
          strokeWidth: 1.0,
        );

        drawSeries(
          lower,
          color,
          strokeWidth: indicator.lineWidth,
        );

        continue;
      }

      if (indicator.type == 'Keltner Channels') {
        final period = math.max(1, indicator.length);

        final atrPeriod = math.max(
          1,
          indicator.length2 > 0 ? indicator.length2 : period,
        );

        final multiplier = indicator.value1 == 0 ? 2.0 : indicator.value1.abs();

        final basis = emaSeries(
          values,
          period,
        );

        final atr = atrSeries(
          atrPeriod,
        );

        final upper = List<double?>.filled(candles.length, null);

        final lower = List<double?>.filled(candles.length, null);

        for (int i = 0; i < candles.length; i++) {
          final middle = basis[i];
          final range = atr[i];

          if (middle == null || range == null) {
            continue;
          }

          upper[i] = middle + multiplier * range;
          lower[i] = middle - multiplier * range;
        }

        drawSeries(
          upper,
          color,
          strokeWidth: indicator.lineWidth,
        );

        drawSeries(
          basis,
          color.withValues(alpha: .60),
          strokeWidth: 1.0,
        );

        drawSeries(
          lower,
          color,
          strokeWidth: indicator.lineWidth,
        );

        continue;
      }

      if (indicator.type == 'Bollinger Bands' &&
          indicator.length > 0 &&
          values.length >= indicator.length) {
        final middle = smaSeries(values, indicator.length);
        final upper = List<double?>.filled(values.length, null);
        final lowerBand = List<double?>.filled(values.length, null);

        for (int i = indicator.length - 1; i < values.length; i++) {
          final mean = middle[i];

          if (mean == null) continue;

          double variance = 0;

          for (int j = i - indicator.length + 1; j <= i; j++) {
            final delta = values[j] - mean;
            variance += delta * delta;
          }

          variance /= indicator.length;

          final deviation = math.sqrt(variance);
          final multiplier = indicator.value1 == 0 ? 2.0 : indicator.value1;

          upper[i] = mean + deviation * multiplier;
          lowerBand[i] = mean - deviation * multiplier;
        }

        drawSeries(upper, color);
        drawSeries(
          middle,
          color.withValues(alpha: .60),
          strokeWidth: 1.0,
        );
        drawSeries(lowerBand, color);
        continue;
      }

      if (indicator.type == 'VWAP') {
        final vwap = List<double?>.filled(candles.length, null);

        double weighted = 0;
        double weight = 0;

        for (int i = 0; i < candles.length; i++) {
          final candle = candles[i];

          final typical = (candle.high + candle.low + candle.close) / 3.0;

          final proxy = math.max(
            (candle.high - candle.low).abs(),
            0.0000001,
          );

          weighted += typical * proxy;
          weight += proxy;

          vwap[i] = weight == 0 ? null : weighted / weight;
        }

        drawSeries(vwap, color, strokeWidth: indicator.lineWidth);
        continue;
      }

      if (indicator.type == 'Ichimoku Cloud') {
        final count = candles.length;

        final tenkan = List<double?>.filled(count, null);
        final kijun = List<double?>.filled(count, null);
        final spanA = List<double?>.filled(count, null);
        final spanB = List<double?>.filled(count, null);
        final chikou = List<double?>.filled(count, null);

        final tenkanPeriod = math.max(1, indicator.length);
        final kijunPeriod = math.max(1, indicator.length2);
        final spanBPeriod = math.max(1, indicator.length3);

        final displacement =
            indicator.value1 > 0 ? indicator.value1.round() : kijunPeriod;

        double midpoint(int index, int period) {
          final first = index - period + 1;

          if (first < 0) {
            return double.nan;
          }

          double highest = candles[first].high;
          double lowest = candles[first].low;

          for (int j = first; j <= index; j++) {
            highest = math.max(highest, candles[j].high);
            lowest = math.min(lowest, candles[j].low);
          }

          return (highest + lowest) / 2.0;
        }

        for (int i = 0; i < count; i++) {
          if (i >= tenkanPeriod - 1) {
            tenkan[i] = midpoint(i, tenkanPeriod);
          }

          if (i >= kijunPeriod - 1) {
            kijun[i] = midpoint(i, kijunPeriod);
          }

          final future = i + displacement;

          if (future < count && tenkan[i] != null && kijun[i] != null) {
            spanA[future] = (tenkan[i]! + kijun[i]!) / 2.0;
          }

          if (future < count && i >= spanBPeriod - 1) {
            spanB[future] = midpoint(i, spanBPeriod);
          }

          final lag = i - displacement;

          if (lag >= 0) {
            chikou[lag] = candles[i].close;
          }
        }

        final cloudBull = Paint()
          ..color = const Color(0xFF27FF88).withValues(alpha: .08)
          ..style = PaintingStyle.fill;

        final cloudBear = Paint()
          ..color = const Color(0xFFFF4057).withValues(alpha: .08)
          ..style = PaintingStyle.fill;

        for (int i = 1; i < count; i++) {
          final a0 = spanA[i - 1];
          final a1 = spanA[i];
          final b0 = spanB[i - 1];
          final b1 = spanB[i];

          if (a0 == null || a1 == null || b0 == null || b1 == null) {
            continue;
          }

          if (a0 < low ||
              a0 > high ||
              a1 < low ||
              a1 > high ||
              b0 < low ||
              b0 > high ||
              b1 < low ||
              b1 > high) {
            continue;
          }

          final x0 = startX + slotWidth * (i - 1) + slotWidth / 2;
          final x1 = startX + slotWidth * i + slotWidth / 2;

          final cloud = Path()
            ..moveTo(x0, yFor(a0))
            ..lineTo(x1, yFor(a1))
            ..lineTo(x1, yFor(b1))
            ..lineTo(x0, yFor(b0))
            ..close();

          canvas.drawPath(
            cloud,
            ((a0 + a1) / 2.0) >= ((b0 + b1) / 2.0) ? cloudBull : cloudBear,
          );
        }

        drawSeries(
          tenkan,
          color,
          strokeWidth: indicator.lineWidth,
        );

        drawSeries(
          kijun,
          color.withValues(alpha: .70),
          strokeWidth: indicator.lineWidth,
        );

        drawSeries(
          spanA,
          const Color(0xFF27FF88).withValues(alpha: .75),
          strokeWidth: 1.0,
        );

        drawSeries(
          spanB,
          const Color(0xFFFF4057).withValues(alpha: .75),
          strokeWidth: 1.0,
        );

        drawSeries(
          chikou,
          color.withValues(alpha: .45),
          strokeWidth: 1.0,
        );

        continue;
      }

      if (indicator.type == 'Parabolic SAR' && candles.length >= 3) {
        final startAf = indicator.value1 > 0 ? indicator.value1 : 0.02;
        final increment = indicator.value2 > 0 ? indicator.value2 : 0.02;
        final maximum = indicator.value3 > 0 ? indicator.value3 : 0.20;

        final sarValues = List<double?>.filled(candles.length, null);

        bool bullish = candles[1].close >= candles[0].close;

        double sar = bullish ? candles[0].low : candles[0].high;

        double extreme = bullish
            ? math.max(candles[0].high, candles[1].high)
            : math.min(candles[0].low, candles[1].low);

        double af = startAf;

        sarValues[1] = sar;

        for (int i = 2; i < candles.length; i++) {
          sar = sar + af * (extreme - sar);

          if (bullish) {
            sar = math.min(
              sar,
              math.min(
                candles[i - 1].low,
                candles[i - 2].low,
              ),
            );

            if (candles[i].low < sar) {
              bullish = false;
              sar = extreme;
              extreme = candles[i].low;
              af = startAf;
            } else if (candles[i].high > extreme) {
              extreme = candles[i].high;
              af = math.min(maximum, af + increment);
            }
          } else {
            sar = math.max(
              sar,
              math.max(
                candles[i - 1].high,
                candles[i - 2].high,
              ),
            );

            if (candles[i].high > sar) {
              bullish = true;
              sar = extreme;
              extreme = candles[i].high;
              af = startAf;
            } else if (candles[i].low < extreme) {
              extreme = candles[i].low;
              af = math.min(maximum, af + increment);
            }
          }

          sarValues[i] = sar;
        }

        final dotPaint = Paint()
          ..color = color
          ..style = PaintingStyle.fill;

        for (int i = 0; i < sarValues.length; i++) {
          final value = sarValues[i];

          if (value == null || !value.isFinite || value < low || value > high) {
            continue;
          }

          final x = startX + slotWidth * i + slotWidth / 2;

          canvas.drawCircle(
            Offset(x, yFor(value)),
            math.max(1.5, indicator.lineWidth + .5),
            dotPaint,
          );
        }

        continue;
      }

      if (indicator.type == 'Williams Alligator') {
        final median =
            candles.map((candle) => (candle.high + candle.low) / 2.0).toList();

        final jawPeriod = indicator.length > 0 ? indicator.length : 13;
        final teethPeriod = indicator.length2 > 0 ? indicator.length2 : 8;
        final lipsPeriod = indicator.length3 > 0 ? indicator.length3 : 5;

        final jaw = rmaSeries(median, jawPeriod);
        final teeth = rmaSeries(median, teethPeriod);
        final lips = rmaSeries(median, lipsPeriod);

        drawSeries(
          jaw,
          const Color(0xFF5C9DFF),
          strokeWidth: indicator.lineWidth,
        );

        drawSeries(
          teeth,
          const Color(0xFFFF4057),
          strokeWidth: indicator.lineWidth,
        );

        drawSeries(
          lips,
          const Color(0xFF27FF88),
          strokeWidth: indicator.lineWidth,
        );

        continue;
      }

      if (indicator.type == 'Supertrend') {
        final period = indicator.length > 0 ? indicator.length : 10;

        final multiplier = indicator.value1 > 0 ? indicator.value1 : 3.0;

        final atr = atrSeries(period);

        final upper = List<double?>.filled(candles.length, null);
        final lowerBand = List<double?>.filled(candles.length, null);
        final trend = List<double?>.filled(candles.length, null);

        bool bullishTrend = true;

        for (int i = 0; i < candles.length; i++) {
          final atrValue = atr[i];

          if (atrValue == null || !atrValue.isFinite) {
            continue;
          }

          final hl2 = (candles[i].high + candles[i].low) / 2.0;

          final basicUpper = hl2 + multiplier * atrValue;
          final basicLower = hl2 - multiplier * atrValue;

          if (i == 0 || upper[i - 1] == null || lowerBand[i - 1] == null) {
            upper[i] = basicUpper;
            lowerBand[i] = basicLower;
            continue;
          }

          upper[i] =
              basicUpper < upper[i - 1]! || candles[i - 1].close > upper[i - 1]!
                  ? basicUpper
                  : upper[i - 1];

          lowerBand[i] = basicLower > lowerBand[i - 1]! ||
                  candles[i - 1].close < lowerBand[i - 1]!
              ? basicLower
              : lowerBand[i - 1];

          if (bullishTrend && candles[i].close < lowerBand[i]!) {
            bullishTrend = false;
          } else if (!bullishTrend && candles[i].close > upper[i]!) {
            bullishTrend = true;
          }

          trend[i] = bullishTrend ? lowerBand[i] : upper[i];
        }

        drawSeries(
          trend,
          color,
          strokeWidth: math.max(
            1.8,
            indicator.lineWidth,
          ),
        );

        continue;
      }

      if (indicator.type == 'Fractals' && candles.length >= 5) {
        final upPaint = Paint()
          ..color = const Color(0xFFFF4057)
          ..style = PaintingStyle.fill;

        final downPaint = Paint()
          ..color = const Color(0xFF27FF88)
          ..style = PaintingStyle.fill;

        for (int i = 2; i < candles.length - 2; i++) {
          final center = candles[i];

          final swingHigh = center.high > candles[i - 1].high &&
              center.high > candles[i - 2].high &&
              center.high > candles[i + 1].high &&
              center.high > candles[i + 2].high;

          final swingLow = center.low < candles[i - 1].low &&
              center.low < candles[i - 2].low &&
              center.low < candles[i + 1].low &&
              center.low < candles[i + 2].low;

          final x = startX + slotWidth * i + slotWidth / 2;

          if (swingHigh && center.high >= low && center.high <= high) {
            final y = yFor(center.high) - 5;

            final marker = Path()
              ..moveTo(x, y)
              ..lineTo(x - 3, y - 5)
              ..lineTo(x + 3, y - 5)
              ..close();

            canvas.drawPath(marker, upPaint);
          }

          if (swingLow && center.low >= low && center.low <= high) {
            final y = yFor(center.low) + 5;

            final marker = Path()
              ..moveTo(x, y)
              ..lineTo(x - 3, y + 5)
              ..lineTo(x + 3, y + 5)
              ..close();

            canvas.drawPath(marker, downPaint);
          }
        }

        continue;
      }

      if (indicator.type == 'Pivot Points' && candles.length >= 2) {
        final previous = candles[candles.length - 2];

        final pivot = (previous.high + previous.low + previous.close) / 3.0;

        final r1 = 2 * pivot - previous.low;
        final s1 = 2 * pivot - previous.high;
        final r2 = pivot + (previous.high - previous.low);
        final s2 = pivot - (previous.high - previous.low);

        void drawLevel(
          double value,
          Color levelColor,
          double width,
        ) {
          if (!value.isFinite || value < low || value > high) {
            return;
          }

          canvas.drawLine(
            Offset(leftPad, yFor(value)),
            Offset(leftPad + chartWidth, yFor(value)),
            Paint()
              ..color = levelColor.withValues(alpha: .55)
              ..strokeWidth = width,
          );
        }

        drawLevel(
          pivot,
          const Color(0xFFFFC857),
          1.4,
        );

        drawLevel(
          r1,
          const Color(0xFFFF4057),
          1.0,
        );

        drawLevel(
          r2,
          const Color(0xFFFF4057),
          .8,
        );

        drawLevel(
          s1,
          const Color(0xFF27FF88),
          1.0,
        );

        drawLevel(
          s2,
          const Color(0xFF27FF88),
          .8,
        );

        continue;
      }

      if (indicator.type == 'ZigZag' && candles.length >= 5) {
        final depth = math.max(2, indicator.length);

        final path = Path();
        bool started = false;

        for (int i = depth; i < candles.length - depth; i++) {
          final candle = candles[i];

          bool swingHigh = true;
          bool swingLow = true;

          for (int j = i - depth; j <= i + depth; j++) {
            if (j == i) continue;

            if (candles[j].high > candle.high) {
              swingHigh = false;
            }

            if (candles[j].low < candle.low) {
              swingLow = false;
            }
          }

          if (!swingHigh && !swingLow) continue;

          final value = swingHigh ? candle.high : candle.low;

          if (value < low || value > high) continue;

          final x = startX + slotWidth * i + slotWidth / 2;
          final y = yFor(value);

          if (!started) {
            path.moveTo(x, y);
            started = true;
          } else {
            path.lineTo(x, y);
          }
        }

        canvas.drawPath(
          path,
          Paint()
            ..color = color
            ..strokeWidth = indicator.lineWidth
            ..style = PaintingStyle.stroke,
        );
      }
    }

    if (currentPrice.isFinite && currentPrice > 0) {
      final currentY = yFor(currentPrice);

      final currentLine = Paint()
        ..color = const Color(0xFF00E5FF).withValues(alpha: .50)
        ..strokeWidth = 1;

      canvas.drawLine(
        Offset(leftPad, currentY),
        Offset(leftPad + chartWidth, currentY),
        currentLine,
      );

      final priceLabel = TextPainter(
        text: TextSpan(
          text: currentPrice.toStringAsFixed(5),
          style: const TextStyle(
            color: Color(0xFF27FF88),
            fontSize: 9,
            fontWeight: FontWeight.w900,
          ),
        ),
        textDirection: TextDirection.ltr,
      )..layout();

      final priceBadgeRect = RRect.fromRectAndRadius(
        Rect.fromLTWH(
          leftPad + chartWidth + 3,
          currentY - priceLabel.height / 2 - 3,
          priceLabel.width + 10,
          priceLabel.height + 6,
        ),
        const Radius.circular(3),
      );

      canvas.drawRRect(
        priceBadgeRect,
        Paint()
          ..color = const Color(0xFF27FF88).withValues(alpha: .16)
          ..style = PaintingStyle.fill,
      );

      canvas.drawRRect(
        priceBadgeRect,
        Paint()
          ..color = const Color(0xFF27FF88).withValues(alpha: .55)
          ..strokeWidth = .8
          ..style = PaintingStyle.stroke,
      );

      priceLabel.paint(
        canvas,
        Offset(
          leftPad + chartWidth + 8,
          currentY - priceLabel.height / 2,
        ),
      );
    }

    for (int i = 0; i <= 6; i++) {
      final value = high - (high - low) * i / 6;

      final y = topPad + chartHeight * i / 6;

      final label = TextPainter(
        text: TextSpan(
          text: value.toStringAsFixed(5),
          style: TextStyle(
            color: Colors.white.withValues(alpha: .50),
            fontSize: 7.5,
            fontWeight: FontWeight.w600,
          ),
        ),
        textDirection: TextDirection.ltr,
      )..layout();

      label.paint(
        canvas,
        Offset(
          leftPad + chartWidth + 6,
          y - label.height / 2,
        ),
      );
    }

    final timeLabelStep = math.max(
      1,
      (count / 8).ceil(),
    );

    for (int i = 0; i < count; i++) {
      if (i % timeLabelStep != 0 && i != count - 1) {
        continue;
      }

      final candle = candles[i];

      final x = startX + slotWidth * i + slotWidth / 2;

      final hour = candle.bucket.hour.toString().padLeft(2, '0');

      final minute = candle.bucket.minute.toString().padLeft(2, '0');

      final timeLabel = TextPainter(
        text: TextSpan(
          text: '$hour:$minute',
          style: TextStyle(
            color: Colors.white.withValues(alpha: .42),
            fontSize: 6.8,
            fontWeight: FontWeight.w600,
          ),
        ),
        textDirection: TextDirection.ltr,
      )..layout();

      timeLabel.paint(
        canvas,
        Offset(
          x - timeLabel.width / 2,
          topPad + chartHeight + 6,
        ),
      );
    }
  }

  @override
  bool shouldRepaint(
    covariant _CandlestickPainter oldDelegate,
  ) {
    return true;
  }
}
