  Future<void> _submitChartDukeCommand([
    String? suppliedCommand,
  ]) async {
    final command =
        (suppliedCommand ?? _chartDukeCommandController.text).trim();

    if (command.isEmpty) {
      return;
    }

    _chartDukeCommandController.clear();

    final duke = AgentDukeGlobalController.instance;

    duke.updateContext(
      page: 'ADVANCED CHART',
      symbol: _chartSymbol,
      timeframe: _chartTimeframe,
    );

    final response = await duke.submit(command);

    if (duke.voice.voiceRepliesEnabled && response.trim().isNotEmpty) {
      await duke.voice.speak(response);
    }

    if (mounted) {
      setState(() {});
    }
  }

