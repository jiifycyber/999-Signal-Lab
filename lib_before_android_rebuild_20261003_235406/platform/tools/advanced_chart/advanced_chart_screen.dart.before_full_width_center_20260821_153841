  Widget _drawToolGlyph(
    String kind, {
    bool active = false,
  }) {
    final color = active ? cyan : Colors.white;

    Widget line({
      required double width,
      required double height,
      double angle = 0,
      double radius = 1,
    }) {
      return Transform.rotate(
        angle: angle,
        child: Container(
          width: width,
          height: height,
          decoration: BoxDecoration(
            color: color,
            borderRadius: BorderRadius.circular(radius),
          ),
        ),
      );
    }

    Widget dot({
      double size = 3.4,
    }) {
      return Container(
        width: size,
        height: size,
        decoration: BoxDecoration(
          color: color,
          shape: BoxShape.circle,
        ),
      );
    }

    Widget smallBox({
      double width = 10,
      double height = 8,
      double border = 1.4,
    }) {
      return Container(
        width: width,
        height: height,
        decoration: BoxDecoration(
          border: Border.all(color: color, width: border),
          borderRadius: BorderRadius.circular(1),
        ),
      );
    }

    switch (kind) {
      case 'crosshair':
        return SizedBox(
          width: 16,
          height: 16,
          child: Stack(
            alignment: Alignment.center,
            children: [
              line(width: 12, height: 1.5),
              line(width: 1.5, height: 12),
              dot(size: 3),
            ],
          ),
        );

      case 'trend':
        return SizedBox(
          width: 16,
          height: 16,
          child: Stack(
            alignment: Alignment.center,
            children: [
              line(width: 13, height: 1.6, angle: -.70),
            ],
          ),
        );

      case 'horizontal':
        return SizedBox(
          width: 16,
          height: 16,
          child: Center(
            child: line(width: 13, height: 1.6),
          ),
        );

      case 'vertical':
        return SizedBox(
          width: 16,
          height: 16,
          child: Center(
            child: line(width: 1.6, height: 13),
          ),
        );

      case 'ray':
        return SizedBox(
          width: 16,
          height: 16,
          child: Stack(
            children: [
              Positioned(
                left: 2,
                bottom: 3,
                child: dot(size: 3.2),
              ),
              Positioned(
                left: 4,
                top: 5,
                child: line(width: 11, height: 1.5, angle: -.70),
              ),
            ],
          ),
        );

      case 'fib':
        return SizedBox(
          width: 16,
          height: 16,
          child: Column(
            mainAxisAlignment: MainAxisAlignment.center,
            children: [
              line(width: 12, height: 1.2),
              const SizedBox(height: 2),
              line(width: 9, height: 1.2),
              const SizedBox(height: 2),
              line(width: 13, height: 1.2),
              const SizedBox(height: 2),
              line(width: 7, height: 1.2),
            ],
          ),
        );

      case 'path':
        return SizedBox(
          width: 16,
          height: 16,
          child: Stack(
            children: [
              Positioned(left: 2, top: 11, child: dot(size: 3)),
              Positioned(
                  left: 6,
                  top: 8,
                  child: line(width: 6, height: 1.2, angle: -.75)),
              Positioned(left: 8, top: 6, child: dot(size: 3)),
              Positioned(
                  left: 9,
                  top: 8,
                  child: line(width: 5, height: 1.2, angle: .75)),
              Positioned(left: 12, top: 11, child: dot(size: 3)),
            ],
          ),
        );

      case 'rect':
        return SizedBox(
          width: 16,
          height: 16,
          child: Center(
            child: smallBox(width: 11, height: 8),
          ),
        );

      case 'text':
        return Text(
          'T',
          style: TextStyle(
            color: color,
            fontSize: 14,
            fontWeight: FontWeight.w900,
            height: 1,
          ),
        );

      case 'add':
        return SizedBox(
          width: 16,
          height: 16,
          child: Stack(
            alignment: Alignment.center,
            children: [
              Container(
                width: 13,
                height: 13,
                decoration: BoxDecoration(
                  shape: BoxShape.circle,
                  border: Border.all(color: color, width: 1.4),
                ),
              ),
              line(width: 7, height: 1.4),
              line(width: 1.4, height: 7),
            ],
          ),
        );

      case 'brush':
        return SizedBox(
          width: 16,
          height: 16,
          child: Stack(
            alignment: Alignment.center,
            children: [
              Positioned(
                top: 3,
                child: line(width: 10, height: 2.2, angle: -.80, radius: 2),
              ),
              Positioned(
                right: 4,
                bottom: 4,
                child: smallBox(width: 4.5, height: 4.5, border: 1.2),
              ),
            ],
          ),
        );

      case 'measure':
        return SizedBox(
          width: 16,
          height: 16,
          child: Stack(
            alignment: Alignment.center,
            children: [
              line(width: 12, height: 1.4),
              Positioned(left: 2, child: line(width: 1.3, height: 7)),
              Positioned(right: 2, child: line(width: 1.3, height: 7)),
            ],
          ),
        );

      case 'zoom':
        return SizedBox(
          width: 16,
          height: 16,
          child: Stack(
            children: [
              Positioned(
                left: 2,
                top: 2,
                child: Container(
                  width: 9,
                  height: 9,
                  decoration: BoxDecoration(
                    shape: BoxShape.circle,
                    border: Border.all(color: color, width: 1.4),
                  ),
                ),
              ),
              Positioned(
                left: 9,
                top: 10,
                child: line(width: 6, height: 1.5, angle: .75),
              ),
            ],
          ),
        );

      case 'freehand':
        return SizedBox(
          width: 16,
          height: 16,
          child: Stack(
            children: [
              Positioned(
                  left: 2,
                  top: 10,
                  child: line(width: 4.5, height: 1.3, angle: -.70)),
              Positioned(
                  left: 5,
                  top: 7,
                  child: line(width: 4.5, height: 1.3, angle: .70)),
              Positioned(
                  left: 8,
                  top: 10,
                  child: line(width: 4.5, height: 1.3, angle: -.70)),
            ],
          ),
        );

      case 'layers':
        return SizedBox(
          width: 16,
          height: 16,
          child: Stack(
            alignment: Alignment.center,
            children: [
              Positioned(
                  top: 2, child: smallBox(width: 9, height: 5, border: 1.1)),
              Positioned(
                  top: 5, child: smallBox(width: 9, height: 5, border: 1.1)),
              Positioned(
                  top: 8, child: smallBox(width: 9, height: 5, border: 1.1)),
            ],
          ),
        );

      case 'favorite':
        return Text(
          '★',
          style: TextStyle(
            color: color,
            fontSize: 12,
            fontWeight: FontWeight.w700,
            height: 1,
          ),
        );

      case 'delete':
        return SizedBox(
          width: 16,
          height: 16,
          child: Stack(
            alignment: Alignment.center,
            children: [
              Positioned(
                top: 3,
                child: Container(
                  width: 9,
                  height: 1.4,
                  color: color,
                ),
              ),
              Positioned(
                top: 5,
                child: Container(
                  width: 8,
                  height: 8,
                  decoration: BoxDecoration(
                    border: Border.all(color: color, width: 1.2),
                    borderRadius: BorderRadius.circular(1),
                  ),
                ),
              ),
              Positioned(left: 6, top: 7, child: line(width: 1.0, height: 5)),
              Positioned(right: 6, top: 7, child: line(width: 1.0, height: 5)),
            ],
          ),
        );
    }

    return const SizedBox.shrink();
  }

