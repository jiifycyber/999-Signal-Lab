import os
import json
import asyncio
import socketio

PO_URL = os.getenv("PO_URL", "https://events-po.com")
PO_AUTH_MESSAGE = os.getenv("PO_AUTH_MESSAGE", "").strip()


class PocketOptionBridge:
    def __init__(self):
        self.sio = socketio.AsyncClient(
            reconnection=False,
            logger=False,
            engineio_logger=False,
        )
        self.authenticated = False
        self.queue = asyncio.Queue()
        self.auth_event = asyncio.Event()
        self._install_handlers()

    def _auth_payload(self):
        if not PO_AUTH_MESSAGE:
            raise RuntimeError("PO_AUTH_MESSAGE is missing")

        raw = PO_AUTH_MESSAGE.strip()

        if raw.startswith("42"):
            raw = raw[2:]

        decoded = json.loads(raw)

        if not isinstance(decoded, list) or len(decoded) < 2:
            raise RuntimeError("Invalid Pocket Option auth message")

        if decoded[0] != "auth":
            raise RuntimeError("Auth message is not an auth event")

        return decoded[1]

    def _install_handlers(self):
        @self.sio.event
        async def connect():
            payload = self._auth_payload()
            await self.sio.emit("auth", payload)

        @self.sio.on("auth/success")
        async def auth_success(data=None):
            self.authenticated = True
            self.auth_event.set()
            await self.queue.put({
                "event": "auth/success",
                "data": data,
            })

        @self.sio.event
        async def disconnect():
            if not self.authenticated:
                self.auth_event.set()

        @self.sio.on("*")
        async def catch_all(event, data=None):
            if event == "auth/success":
                return
            await self.queue.put({
                "event": event,
                "data": data,
            })

    async def connect(self):
        await self.sio.connect(
            PO_URL,
            transports=["websocket"],
            socketio_path="socket.io",
            wait_timeout=15,
        )

        try:
            await asyncio.wait_for(self.auth_event.wait(), timeout=15)
        except asyncio.TimeoutError:
            raise RuntimeError("Pocket Option authentication timed out")

        if not self.authenticated:
            raise RuntimeError("Pocket Option authentication failed")

    async def messages(self):
        if not self.sio.connected or not self.authenticated:
            await self.connect()

        while True:
            item = await self.queue.get()
            yield json.dumps(item, separators=(",", ":"))

    async def close(self):
        if self.sio.connected:
            await self.sio.disconnect()

        self.authenticated = False
