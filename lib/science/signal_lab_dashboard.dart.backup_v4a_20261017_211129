  int _digits(double price) {
    if (price >= 1000) return 2;
    if (price >= 100) return 3;
    if (price >= 1) return 5;
    return 6;
  }

  double _momentum(List<double> series) {
    if (series.length < 2) return 0;
    final base = series[math.max(0, series.length - 20)];
    if (base == 0) return 0;
    return ((series.last - base) / base) * 10000;
  }

  double _velocity(List<double> series) {
    if (series.length < 3) return 0;
    final base = series[math.max(0, series.length - 8)];
    if (base == 0) return 0;
    return ((series.last - base) / base) * 10000;
  }

  double _volatility(List<double> series) {
    if (series.length < 3) return 0;
    final start = math.max(1, series.length - 30);
    double sum = 0;
    int n = 0;
    for (int i = start; i < series.length; i++) {
      final p = series[i - 1];
      if (p != 0) {
        sum += ((series[i] - p) / p).abs() * 10000;
        n++;
      }
    }
    return n == 0 ? 0 : sum / n;
  }

  double _reversal(List<double> series) {
    if (series.length < 5) return 0;
    final window = series.sublist(math.max(0, series.length - 40));
    final mean = window.reduce((a, b) => a + b) / window.length;
    if (mean == 0) return 0;
    final deviation = ((series.last - mean) / mean).abs() * 10000;
    return (deviation / 10).clamp(0.0, 1.0);
  }
}

class _LabChartPainter extends CustomPainter {
  final List<double> values;
  const _LabChartPainter(this.values);

  @override
  void paint(Canvas canvas, Size size) {
    final grid = Paint()
      ..color = const Color(0xFF13354A)
      ..strokeWidth = .6;
    for (int i = 1; i < 5; i++) {
      final y = size.height * i / 5;
      canvas.drawLine(Offset(0, y), Offset(size.width, y), grid);
    }
    for (int i = 1; i < 6; i++) {
      final x = size.width * i / 6;
      canvas.drawLine(Offset(x, 0), Offset(x, size.height), grid);
    }

    if (values.length < 2) return;
    final shown = values.sublist(math.max(0, values.length - 90));
    final minV = shown.reduce(math.min);
    final maxV = shown.reduce(math.max);
    final span = math.max(maxV - minV, 1e-9);

    final glow = Paint()
      ..color = const Color(0x4416E0FF)
      ..strokeWidth = 5
      ..style = PaintingStyle.stroke;
    final line = Paint()
      ..color = const Color(0xFF16E0FF)
      ..strokeWidth = 2
      ..style = PaintingStyle.stroke;

    final path = Path();
    for (int i = 0; i < shown.length; i++) {
      final x = size.width * i / (shown.length - 1);
      final y = size.height -
          ((shown[i] - minV) / span) * (size.height * .82) -
          size.height * .09;
      if (i == 0) {
        path.moveTo(x, y);
      } else {
        path.lineTo(x, y);
      }
    }
    canvas.drawPath(path, glow);
    canvas.drawPath(path, line);
  }

  @override
  bool shouldRepaint(covariant _LabChartPainter oldDelegate) => true;
}

class _TickFlowPainter extends CustomPainter {
  final List<double> values;
  const _TickFlowPainter(this.values);

  @override
  void paint(Canvas canvas, Size size) {
    if (values.length < 3) return;
    final shown = values.sublist(math.max(0, values.length - 70));

    final buy = Path();
    final sell = Path();
    double buyLevel = size.height * .55;
    double sellLevel = size.height * .55;

    for (int i = 1; i < shown.length; i++) {
      final delta = shown[i] - shown[i - 1];
      buyLevel += delta > 0 ? -2.2 : 1.0;
      sellLevel += delta < 0 ? -2.2 : 1.0;
      buyLevel = buyLevel.clamp(5.0, size.height - 5);
      sellLevel = sellLevel.clamp(5.0, size.height - 5);
      final x = size.width * i / (shown.length - 1);
      if (i == 1) {
        buy.moveTo(x, buyLevel);
        sell.moveTo(x, sellLevel);
      } else {
        buy.lineTo(x, buyLevel);
        sell.lineTo(x, sellLevel);
      }
    }

    canvas.drawPath(
        buy,
        Paint()
          ..color = const Color(0xFF20F59A)
          ..strokeWidth = 1.8
          ..style = PaintingStyle.stroke);
    canvas.drawPath(
        sell,
        Paint()
          ..color = const Color(0xFFE449FF)
          ..strokeWidth = 1.8
          ..style = PaintingStyle.stroke);
  }

  @override
  bool shouldRepaint(covariant _TickFlowPainter oldDelegate) => true;
}
