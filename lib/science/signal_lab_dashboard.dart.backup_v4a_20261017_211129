      border: _green,
      icon: Icons.trending_up,
      title: 'LIVE PREDICTION',
      subtitle: 'REAL-TIME MODEL (TECHNICAL)',
      direction: direction,
      directionColor: color,
      confidence:
          confidence == null ? '--' : '${confidence.toStringAsFixed(1)}%',
      agreement: signal == null ? '--' : signal.setupQuality,
      evidence: signal?.regime ?? 'COLLECTING',
    );
  }

