  static const _bg = Color(0xFF020D19);
  static const _panel = Color(0xFF071A2C);
  static const _panel2 = Color(0xFF0A2036);
  static const _cyan = Color(0xFF16E0FF);
  static const _green = Color(0xFF20F59A);
  static const _gold = Color(0xFFFFCF4A);
  static const _magenta = Color(0xFFE449FF);
  static const _red = Color(0xFFFF416C);
  static const _muted = Color(0xFF91A8BA);

  late final ScannerController _controller;
  StreamSubscription<List<ForexQuote>>? _quoteSub;
  StreamSubscription<List<ScanSignal>>? _signalSub;

  final Map<String, double> _prices = {};
  final Map<String, ScanSignal> _signals = {};
  final Map<String, List<double>> _history = {};
  String? _selectedSymbol;
  int _liveTicks = 0;
  bool _connected = false;

  @override
  void initState() {
    super.initState();
    _controller = ScannerController();

    _quoteSub = _controller.quoteStream.listen((quotes) {
      if (!mounted) return;
      setState(() {
        for (final q in quotes) {
          _prices[q.symbol] = q.price;
          final series = _history.putIfAbsent(q.symbol, () => <double>[]);
          series.add(q.price);
          if (series.length > 240) series.removeRange(0, series.length - 240);
          _liveTicks++;
        }
        _connected = quotes.isNotEmpty;
        _selectedSymbol ??= _prices.keys.isNotEmpty ? _prices.keys.first : null;
      });
    });

    _signalSub = _controller.signalStream.listen((signals) {
      if (!mounted) return;
      setState(() {
        for (final s in signals) {
          _signals[s.symbol] = s;
        }
      });
    });

    _controller.setLiveMode();
    _controller.start();
  }

  @override
  void dispose() {
    _quoteSub?.cancel();
    _signalSub?.cancel();
    _controller.dispose();
    super.dispose();
  }

  List<String> get _symbols => _prices.keys.toList()..sort();

  String get _symbol {
    final selected = _selectedSymbol;
    if (selected != null && _prices.containsKey(selected)) return selected;
    return _symbols.isNotEmpty ? _symbols.first : 'WAITING_FOR_MARKET';
  }

  double? get _price => _prices[_symbol];
  ScanSignal? get _signal => _signals[_symbol];

