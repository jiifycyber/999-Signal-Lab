  Map<String, dynamic> _scienceStats = const {};
  bool _statsLoading = false;
  Timer? _statsTimer;

  @override
  void initState() {
    super.initState();
    _controller = ScannerController();

    _quoteSub = _controller.quoteStream.listen((quotes) {
      if (!mounted) return;
      setState(() {
        for (final q in quotes) {
          _prices[q.symbol] = q.price;
          final series = _history.putIfAbsent(q.symbol, () => <double>[]);
          series.add(q.price);
          if (series.length > 240) series.removeRange(0, series.length - 240);
          _liveTicks++;
        }
        _connected = quotes.isNotEmpty;
        _selectedSymbol ??= _prices.keys.isNotEmpty ? _prices.keys.first : null;
        if (_selectedSymbol != null &&
            _selectedSymbol != _regimeLoadedSymbol &&
            !_regimeLoading) {
          _loadRegime24h(_selectedSymbol!);
        }
      });
    });

    _signalSub = _controller.signalStream.listen((signals) {
      if (!mounted) return;
      setState(() {
        for (final s in signals) {
          _signals[s.symbol] = s;
        }
      });
    });

    _controller.setLiveMode();
    _controller.start();
    _loadScienceStats();
    _statsTimer = Timer.periodic(
      const Duration(seconds: 15),
      (_) => _loadScienceStats(),
    );
  }

  Future<void> _loadScienceStats() async {
    if (_statsLoading) return;
    _statsLoading = true;
    try {
      final response =
          await http.get(Uri.parse('http://127.0.0.1:9198/science/stats'));
      if (response.statusCode != 200) return;
      final decoded = jsonDecode(response.body);
      if (decoded is! Map<String, dynamic>) return;
      if (!mounted) return;
      setState(() {
        _scienceStats = decoded;
      });
    } catch (error) {
      // Preserve the last valid 24H vault statistics if the API is unavailable.
    } finally {
      _statsLoading = false;
    }
  }

  Future<void> _loadRegime24h(String symbol) async {
    if (_regimeLoading) return;
    _regimeLoading = true;
    try {
      final uri = Uri.parse(
          'http://127.0.0.1:9198/science/regime/${Uri.encodeComponent(symbol)}');
      final response = await http.get(uri);
      if (response.statusCode != 200) return;
      final decoded = jsonDecode(response.body);
      if (decoded is! Map<String, dynamic>) return;
      final percentages = decoded['percentages'];
      if (percentages is! Map<String, dynamic>) return;
      final next = <String, double>{};
      for (final key in const [
        'bullish_trend',
        'bearish_trend',
        'range',
        'high_volatility',
        'transition',
      ]) {
        final value = percentages[key];
        if (value is num) next[key] = value.toDouble();
      }
      if (!mounted) return;
      setState(() {
        _regime24h = next;
        _regimeLoadedSymbol = symbol;
      });
    } catch (error) {
      // Preserve the last known 24H regime data if the local API request fails.
    } finally {
      _regimeLoading = false;
    }
  }

  @override
  void dispose() {
    _statsTimer?.cancel();
    _scrollController.dispose();
    _quoteSub?.cancel();
    _signalSub?.cancel();
    _controller.dispose();
    super.dispose();
  }

  List<String> get _symbols => _prices.keys.toList()..sort();

  String get _symbol {
    final selected = _selectedSymbol;
    if (selected != null && _prices.containsKey(selected)) return selected;
    return _symbols.isNotEmpty ? _symbols.first : 'WAITING_FOR_MARKET';
  }

  double? get _price => _prices[_symbol];
  ScanSignal? get _signal => _signals[_symbol];

  @override
  Widget build(BuildContext context) {
    final symbol = _symbol;
    final price = _price;
    final signal = _signal;
    if (symbol != 'WAITING_FOR_MARKET' &&
