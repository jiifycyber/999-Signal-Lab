class _LabChartPainter extends CustomPainter {
  final List<double> values;
  const _LabChartPainter(this.values);

  @override
  void paint(Canvas canvas, Size size) {
    const left = 4.0;
    const top = 8.0;
    const right = 42.0;
    const bottom = 20.0;
    final w = math.max(1.0, size.width - left - right);
    final h = math.max(1.0, size.height - top - bottom);

    final grid = Paint()
      ..color = const Color(0xFF13354A)
      ..strokeWidth = .7;

    for (int i = 0; i <= 4; i++) {
      final y = top + h * i / 4;
      canvas.drawLine(Offset(left, y), Offset(left + w, y), grid);
    }
    for (int i = 0; i <= 5; i++) {
      final x = left + w * i / 5;
      canvas.drawLine(Offset(x, top), Offset(x, top + h), grid);
    }

    if (values.length < 2) {
      final tp = TextPainter(
        text: const TextSpan(
          text: 'COLLECTING LIVE PRICE HISTORY',
          style: TextStyle(
            color: Color(0xFF91A8BA),
            fontSize: 8,
            fontWeight: FontWeight.w700,
          ),
        ),
        textDirection: TextDirection.ltr,
      )..layout();
      tp.paint(
        canvas,
        Offset(
          left + (w - tp.width) / 2,
          top + (h - tp.height) / 2,
        ),
      );
      return;
    }

    final shown = values.sublist(math.max(0, values.length - 120));
    final rawMin = shown.reduce(math.min);
    final rawMax = shown.reduce(math.max);
    final rawSpan = math.max(rawMax - rawMin, rawMax.abs() * 0.00002);
    final minV = rawMin - rawSpan * .12;
    final maxV = rawMax + rawSpan * .12;
    final span = maxV - minV;

    Offset point(int i) {
      final x = left + w * i / math.max(1, shown.length - 1);
      final y = top + h - ((shown[i] - minV) / span) * h;
      return Offset(x, y);
    }

    final glow = Paint()
      ..color = const Color(0x3316E0FF)
      ..strokeWidth = 6
      ..style = PaintingStyle.stroke
      ..strokeCap = StrokeCap.round
      ..strokeJoin = StrokeJoin.round;

    final line = Paint()
      ..color = const Color(0xFF16E0FF)
      ..strokeWidth = 2.1
      ..style = PaintingStyle.stroke
      ..strokeCap = StrokeCap.round
      ..strokeJoin = StrokeJoin.round;

    final path = Path()..moveTo(point(0).dx, point(0).dy);
    for (int i = 1; i < shown.length; i++) {
      path.lineTo(point(i).dx, point(i).dy);
    }
    canvas.drawPath(path, glow);
    canvas.drawPath(path, line);

    final latest = point(shown.length - 1);
    canvas.drawCircle(
      latest,
      4.5,
      Paint()..color = const Color(0x3320F59A),
    );
    canvas.drawCircle(
      latest,
      2.5,
      Paint()..color = const Color(0xFF20F59A),
    );

    final marker = Paint()
      ..color = const Color(0xAA20F59A)
      ..strokeWidth = .8;
    canvas.drawLine(
      Offset(left, latest.dy),
      Offset(left + w, latest.dy),
      marker,
    );

    final digits = rawMax >= 100
        ? 2
        : rawMax >= 1
            ? 5
            : 6;

    for (int i = 0; i <= 4; i++) {
      final v = maxV - span * i / 4;
      final tp = TextPainter(
        text: TextSpan(
          text: v.toStringAsFixed(digits),
          style: const TextStyle(
            color: Color(0xFF91A8BA),
            fontSize: 6.5,
          ),
        ),
        textDirection: TextDirection.ltr,
      )..layout(maxWidth: right - 2);
      final y = top + h * i / 4 - tp.height / 2;
      tp.paint(canvas, Offset(left + w + 4, y));
    }

    const labels = ['-2m', '-90s', '-60s', '-30s', '-15s', 'NOW'];
    for (int i = 0; i < labels.length; i++) {
      final tp = TextPainter(
        text: TextSpan(
          text: labels[i],
          style: const TextStyle(
            color: Color(0xFF91A8BB),
            fontSize: 6.3,
          ),
        ),
        textDirection: TextDirection.ltr,
      )..layout();
      final x = left + w * i / (labels.length - 1) - tp.width / 2;
      tp.paint(canvas, Offset(x.clamp(left, left + w - tp.width), top + h + 5));
    }
  }

  @override
  bool shouldRepaint(covariant _LabChartPainter oldDelegate) => true;
}

class _TickFlowPainter extends CustomPainter {
  final List<double> values;
  const _TickFlowPainter(this.values);

  @override
  void paint(Canvas canvas, Size size) {
    if (values.length < 3) return;
    final shown = values.sublist(math.max(0, values.length - 70));

    final buy = Path();
    final sell = Path();
    double buyLevel = size.height * .55;
    double sellLevel = size.height * .55;

    for (int i = 1; i < shown.length; i++) {
      final delta = shown[i] - shown[i - 1];
      buyLevel += delta > 0 ? -2.2 : 1.0;
      sellLevel += delta < 0 ? -2.2 : 1.0;
      buyLevel = buyLevel.clamp(5.0, size.height - 5);
      sellLevel = sellLevel.clamp(5.0, size.height - 5);
      final x = size.width * i / (shown.length - 1);
      if (i == 1) {
        buy.moveTo(x, buyLevel);
        sell.moveTo(x, sellLevel);
      } else {
        buy.lineTo(x, buyLevel);
        sell.lineTo(x, sellLevel);
      }
    }

    canvas.drawPath(
        buy,
        Paint()
          ..color = const Color(0xFF20F59A)
          ..strokeWidth = 1.8
          ..style = PaintingStyle.stroke);
    canvas.drawPath(
        sell,
        Paint()
          ..color = const Color(0xFFE449FF)
          ..strokeWidth = 1.8
          ..style = PaintingStyle.stroke);
  }

  @override
  bool shouldRepaint(covariant _TickFlowPainter oldDelegate) => true;
}
