  Future<void> _loadScienceFeatures(String symbol) async {
    if (_featuresLoading) return;
    _featuresLoading = true;
    try {
      final uri = Uri.parse(
        "http://127.0.0.1:9198/science/features/${Uri.encodeComponent(symbol)}",
      );
      final response = await http.get(uri);
      if (response.statusCode != 200) return;
      final decoded = jsonDecode(response.body);
      if (decoded is! Map<String, dynamic>) return;
      if (!mounted) return;
      setState(() {
        _scienceFeatures = decoded;
        _featuresLoadedSymbol = symbol;
      });
    } catch (error) {
      // Preserve the last valid Science snapshot if the API is unavailable.
    } finally {
      _featuresLoading = false;
    }
  }

  Widget _scienceMetricRow(String symbol, ScanSignal? signal) {
    if (_featuresLoadedSymbol != symbol && !_featuresLoading) {
      WidgetsBinding.instance.addPostFrameCallback((_) {
        if (mounted) _loadScienceFeatures(symbol);
      });
    }

    final ready = _scienceFeatures["status"] == "ready" &&
        _featuresLoadedSymbol == symbol;
    final momentumMap = _scienceFeatures["momentum_bps"];
    final meanReversion = _scienceFeatures["mean_reversion"];

    final momentum = ready && momentumMap is Map
        ? (momentumMap["60s"] as num?)?.toDouble()
        : null;
    final velocity = ready
        ? (_scienceFeatures["velocity_bps_per_sec"] as num?)?.toDouble()
        : null;
    final volatility =
        ready ? (_scienceFeatures["volatility_bps"] as num?)?.toDouble() : null;
    final reversal = ready && meanReversion is Map
        ? (meanReversion["pressure_0_to_1"] as num?)?.toDouble()
        : null;

    final momentumText =
        momentum == null ? "COLLECTING" : "${momentum.toStringAsFixed(2)} bps";
    final velocityText =
        velocity == null ? "COLLECTING" : velocity.toStringAsFixed(4);
    final volatilityText = volatility == null
        ? "COLLECTING"
        : "${volatility.toStringAsFixed(2)} bps";
    final reversalText = reversal == null
        ? "COLLECTING"
        : "${(reversal * 100).toStringAsFixed(1)}%";

    return Row(
      children: [
        Expanded(child: _smallMetric("MOMENTUM", momentumText, _green)),
        const SizedBox(width: 5),
        Expanded(child: _smallMetric("VELOCITY", velocityText, _cyan)),
