  int _priceDigits(double price) {
    if (price >= 1000) return 2;
    if (price >= 100) return 3;
    if (price >= 1) return 5;
    return 6;
  }

  int _pct(double value) {
    final pct = value <= 1.0 ? value * 100 : value;
    return pct.round().clamp(0, 100);
  }

  double _confidence01(double value) {
    final normalized = value <= 1.0 ? value : value / 100.0;
    return normalized.clamp(0.0, 1.0);
  }

  Color _directionColor(TradeDirection direction) {
    switch (direction) {
      case TradeDirection.buy:
        return _green;
      case TradeDirection.sell:
        return _red;
      case TradeDirection.wait:
        return _gold;
    }
  }

  double _simpleMomentum(List<double> series) {
    if (series.length < 2) return 0;
    final n = math.min(20, series.length - 1);
    final base = series[series.length - 1 - n];
    if (base == 0) return 0;
    return ((series.last - base) / base) * 10000;
  }

  double _simpleVelocity(List<double> series) {
    if (series.length < 3) return 0;
    return _simpleMomentum(series) / math.min(20, series.length - 1);
  }

  double _simpleVolatility(List<double> series) {
    if (series.length < 3) return 0;
    final window = series.skip(math.max(0, series.length - 30)).toList();
    var sum = 0.0;
    for (var i = 1; i < window.length; i++) {
      final p = window[i - 1];
      if (p != 0) sum += ((window[i] - p) / p).abs() * 10000;
    }
    return sum / math.max(1, window.length - 1);
  }

  double _reversalProxy(List<double> series) {
    if (series.length < 5) return 0;
    final window = series.skip(math.max(0, series.length - 30)).toList();
    final mean = window.reduce((a, b) => a + b) / window.length;
    if (mean == 0) return 0;
    return ((series.last - mean) / mean).abs() * 10000;
  }
}

class _LabChartPainter extends CustomPainter {
  const _LabChartPainter(this.values);

  final List<double> values;

  @override
  void paint(Canvas canvas, Size size) {
    final grid = Paint()
      ..color = const Color(0x2213D9FF)
      ..strokeWidth = 1;

    for (var i = 1; i < 5; i++) {
      final y = size.height * i / 5;
      canvas.drawLine(Offset(0, y), Offset(size.width, y), grid);
    }
    for (var i = 1; i < 6; i++) {
      final x = size.width * i / 6;
      canvas.drawLine(Offset(x, 0), Offset(x, size.height), grid);
    }

    if (values.length < 2) return;

    final minV = values.reduce(math.min);
    final maxV = values.reduce(math.max);
    final range = math.max(maxV - minV, 1e-12);
    final path = Path();

    for (var i = 0; i < values.length; i++) {
      final x = size.width * i / (values.length - 1);
      final y =
          size.height - ((values[i] - minV) / range) * (size.height - 18) - 9;
      if (i == 0) {
        path.moveTo(x, y);
      } else {
        path.lineTo(x, y);
      }
    }

    final glow = Paint()
      ..color = const Color(0x5513D9FF)
      ..style = PaintingStyle.stroke
      ..strokeWidth = 6;
    final line = Paint()
      ..color = const Color(0xFF13D9FF)
      ..style = PaintingStyle.stroke
      ..strokeWidth = 2;

    canvas.drawPath(path, glow);
    canvas.drawPath(path, line);
  }

  @override
  bool shouldRepaint(covariant _LabChartPainter oldDelegate) =>
      oldDelegate.values != values;
}
