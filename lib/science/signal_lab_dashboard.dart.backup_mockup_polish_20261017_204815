  static const _magenta = Color(0xFFE448FF);
  static const _red = Color(0xFFFF4F79);

  late final ScannerController _controller;
  StreamSubscription<List<ForexQuote>>? _quotesSub;
  StreamSubscription<List<ScanSignal>>? _signalsSub;

  final Map<String, double> _prices = {};
  final Map<String, List<double>> _history = {};
  final Map<String, ScanSignal> _signals = {};

  String? _selectedSymbol;
  int _liveTicks = 0;
  bool _connected = false;
  int _navIndex = 0;

  @override
  void initState() {
    super.initState();
    _controller = ScannerController();

    _quotesSub = _controller.quoteStream.listen((quotes) {
      if (!mounted) return;
      setState(() {
        _connected = true;
        for (final quote in quotes) {
          _prices[quote.symbol] = quote.price;
          final series = _history.putIfAbsent(quote.symbol, () => <double>[]);
          series.add(quote.price);
          if (series.length > 180) {
            series.removeRange(0, series.length - 180);
          }
          _liveTicks++;
          _selectedSymbol ??= quote.symbol;
        }
      });
    });

    _signalsSub = _controller.signalStream.listen((signals) {
      if (!mounted) return;
      setState(() {
        for (final signal in signals) {
          _signals[signal.symbol] = signal;
        }
      });
    });

    _controller.setLiveMode();
    _controller.start();
  }

  @override
  void dispose() {
    _quotesSub?.cancel();
    _signalsSub?.cancel();
    _controller.dispose();
    super.dispose();
  }

  List<String> get _symbols {
    final rows = _prices.keys.toList()..sort();
    return rows;
  }

  String get _symbol {
    final selected = _selectedSymbol;
    if (selected != null && _prices.containsKey(selected)) return selected;
    return _symbols.isNotEmpty ? _symbols.first : 'WAITING_FOR_MARKET';
  }

  double? get _price => _prices[_symbol];
  ScanSignal? get _signal => _signals[_symbol];

