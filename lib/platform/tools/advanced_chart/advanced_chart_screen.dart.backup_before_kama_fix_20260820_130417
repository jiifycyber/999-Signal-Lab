  Widget _chartWorkspace() {
    final active = _activeIndicators.where((item) => item.visible).toList();

    _IndicatorConfig? rsiConfig;
    _IndicatorConfig? macdConfig;

    for (final indicator in active) {
      if (indicator.type == 'Relative Strength Index') {
        rsiConfig = indicator;
      }

      if (indicator.type == 'MACD') {
        macdConfig = indicator;
      }
    }

    final hasRsi = rsiConfig != null;
    final hasMacd = macdConfig != null;

    if (!hasRsi && !hasMacd) {
      return _chartPanel();
    }

    final closes = candles.map((candle) => candle.close).toList();

    final rsiValues = rsiConfig == null
        ? const <double?>[]
        : _rsi(
            closes,
            rsiConfig.length,
          );

    final macdData = macdConfig == null
        ? <String, List<double?>>{}
        : _macd(
            closes,
            fastPeriod: macdConfig.length,
            slowPeriod: macdConfig.length2,
            signalPeriod: macdConfig.length3,
          );

    final macdValues = macdData['macd'] ?? const <double?>[];

    final signalValues = macdData['signal'] ?? const <double?>[];

    final histogramValues = macdData['histogram'] ?? const <double?>[];

    Widget paneShell({
      required Widget child,
      required Color borderColor,
    }) {
      return Container(
        height: 132,
        margin: const EdgeInsets.fromLTRB(
          8,
          0,
          6,
          5,
        ),
        decoration: BoxDecoration(
          color: const Color(0xFF030B13),
          borderRadius: BorderRadius.circular(8),
          border: Border.all(
            color: borderColor.withValues(alpha: .28),
          ),
        ),
        clipBehavior: Clip.antiAlias,
        child: child,
      );
    }

    return Column(
      children: [
        Expanded(
          child: _chartPanel(),
        ),
        if (macdConfig != null)
          paneShell(
            borderColor: purple,
            child: CustomPaint(
              painter: _MacdPainter(
                macd: macdValues,
                signal: signalValues,
                histogram: histogramValues,
                fastPeriod: macdConfig.length,
                slowPeriod: macdConfig.length2,
                signalPeriod: macdConfig.length3,
              ),
              child: const SizedBox.expand(),
            ),
          ),
        if (rsiConfig != null)
          paneShell(
            borderColor: cyan,
            child: CustomPaint(
              painter: _RsiPainter(
                values: rsiValues,
                period: rsiConfig.length,
                upperLevel: rsiConfig.value1 == 0 ? 70 : rsiConfig.value1,
                lowerLevel: rsiConfig.value2 == 0 ? 30 : rsiConfig.value2,
              ),
              child: const SizedBox.expand(),
            ),
          ),
      ],
    );
  }

