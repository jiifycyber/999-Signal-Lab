  List<double?> _sma(List<double> values, int period) {
    final result = List<double?>.filled(values.length, null);

    if (period <= 0 || values.length < period) {
      return result;
    }

    double sum = 0;

    for (int i = 0; i < values.length; i++) {
      sum += values[i];

      if (i >= period) {
        sum -= values[i - period];
      }

      if (i >= period - 1) {
        result[i] = sum / period;
      }
    }

    return result;
  }

  List<double?> _ema(List<double> values, int period) {
    final result = List<double?>.filled(values.length, null);

    if (values.isEmpty || period <= 0) {
      return result;
    }

    final multiplier = 2.0 / (period + 1.0);
    double emaValue = values.first;

    result[0] = emaValue;

    for (int i = 1; i < values.length; i++) {
      emaValue = ((values[i] - emaValue) * multiplier) + emaValue;

      result[i] = emaValue;
    }

    return result;
  }

  List<double?> _rsi(List<double> values, int period) {
    final result = List<double?>.filled(values.length, null);

    if (values.length <= period) {
      return result;
    }

    double gain = 0;
    double loss = 0;

    for (int i = 1; i <= period; i++) {
      final delta = values[i] - values[i - 1];

      if (delta >= 0) {
        gain += delta;
      } else {
        loss -= delta;
      }
    }

    double avgGain = gain / period;
    double avgLoss = loss / period;

    result[period] =
        avgLoss == 0 ? 100 : 100 - (100 / (1 + (avgGain / avgLoss)));

    for (int i = period + 1; i < values.length; i++) {
      final delta = values[i] - values[i - 1];

      final currentGain = delta > 0 ? delta : 0.0;
      final currentLoss = delta < 0 ? -delta : 0.0;

      avgGain = ((avgGain * (period - 1)) + currentGain) / period;

      avgLoss = ((avgLoss * (period - 1)) + currentLoss) / period;

      result[i] = avgLoss == 0 ? 100 : 100 - (100 / (1 + (avgGain / avgLoss)));
    }

    return result;
  }

  Map<String, List<double?>> _bollinger(
    List<double> values, {
    int period = 20,
    double deviation = 2.0,
  }) {
    final middle = _sma(values, period);
    final upper = List<double?>.filled(values.length, null);
    final lower = List<double?>.filled(values.length, null);

    for (int i = period - 1; i < values.length; i++) {
      final slice = values.sublist(i - period + 1, i + 1);
      final mean = middle[i]!;

      double variance = 0;

      for (final value in slice) {
        variance += (value - mean) * (value - mean);
      }

      variance /= period;

      final stdDev = math.sqrt(variance);

      upper[i] = mean + deviation * stdDev;
      lower[i] = mean - deviation * stdDev;
    }

    return <String, List<double?>>{
      'middle': middle,
      'upper': upper,
      'lower': lower,
    };
  }

  List<double?> _atr(
    List<_OhlcCandle> source, {
    int period = 14,
  }) {
    final result = List<double?>.filled(source.length, null);

    if (source.length <= period) {
      return result;
    }

    final tr = List<double>.filled(source.length, 0);

    for (int i = 1; i < source.length; i++) {
      final highLow = source[i].high - source[i].low;

      final highClose = (source[i].high - source[i - 1].close).abs();

      final lowClose = (source[i].low - source[i - 1].close).abs();

      tr[i] = math.max(
        highLow,
        math.max(highClose, lowClose),
      );
    }

    double sum = 0;

    for (int i = 1; i <= period; i++) {
      sum += tr[i];
    }

    double value = sum / period;

    result[period] = value;

    for (int i = period + 1; i < source.length; i++) {
      value = ((value * (period - 1)) + tr[i]) / period;

      result[i] = value;
    }

    return result;
  }

  Map<String, List<double?>> _macd(
    List<double> values, {
    int fastPeriod = 12,
    int slowPeriod = 26,
    int signalPeriod = 9,
  }) {
    final safeFast = fastPeriod.clamp(1, 5000);
    final safeSlow = slowPeriod.clamp(1, 5000);
    final safeSignal = signalPeriod.clamp(1, 5000);

    final fast = _ema(values, safeFast);
    final slow = _ema(values, safeSlow);

    final macd = List<double?>.filled(values.length, null);

    for (int i = 0; i < values.length; i++) {
      if (fast[i] != null && slow[i] != null) {
        macd[i] = fast[i]! - slow[i]!;
      }
    }

    final signal = List<double?>.filled(
      values.length,
      null,
    );

    final validMacd = <double>[];
    final validIndexes = <int>[];

    for (int i = 0; i < macd.length; i++) {
      final value = macd[i];

      if (value != null && value.isFinite) {
        validMacd.add(value);
        validIndexes.add(i);
      }
    }

    if (validMacd.isNotEmpty) {
      final compactSignal = _ema(
        validMacd,
        safeSignal,
      );

      for (int i = 0; i < compactSignal.length; i++) {
        final value = compactSignal[i];

        if (value != null) {
          signal[validIndexes[i]] = value;
        }
      }
    }

    final histogram = List<double?>.filled(values.length, null);

    for (int i = 0; i < values.length; i++) {
      if (macd[i] != null && signal[i] != null) {
        histogram[i] = macd[i]! - signal[i]!;
      }
    }

    return <String, List<double?>>{
      'macd': macd,
      'signal': signal,
      'histogram': histogram,
    };
  }

  Map<String, List<double?>> _stochastic(
    List<_OhlcCandle> source, {
    int period = 14,
    int smoothK = 3,
    int dPeriod = 3,
  }) {
    final safePeriod = period.clamp(1, 5000);
    final safeSmoothK = smoothK.clamp(1, 5000);
    final safeD = dPeriod.clamp(1, 5000);

    final rawK = List<double?>.filled(source.length, null);

    for (int i = safePeriod - 1; i < source.length; i++) {
      double highest = source[i].high;
      double lowest = source[i].low;

      for (int j = i - safePeriod + 1; j <= i; j++) {
        highest = math.max(highest, source[j].high);
        lowest = math.min(lowest, source[j].low);
      }

      final range = highest - lowest;

      if (range != 0) {
        rawK[i] = ((source[i].close - lowest) / range) * 100;
      }
    }

    List<double?> smoothNullable(
      List<double?> input,
      int smoothing,
    ) {
      if (smoothing <= 1) {
        return List<double?>.from(input);
      }

      final result = List<double?>.filled(input.length, null);

      for (int i = smoothing - 1; i < input.length; i++) {
        double sum = 0;
        int count = 0;

        for (int j = i - smoothing + 1; j <= i; j++) {
          final value = input[j];

          if (value != null && value.isFinite) {
            sum += value;
            count++;
          }
        }

        if (count == smoothing) {
          result[i] = sum / count;
        }
      }

      return result;
    }

    final k = smoothNullable(rawK, safeSmoothK);
    final d = smoothNullable(k, safeD);

    return <String, List<double?>>{
      'rawK': rawK,
      'k': k,
      'd': d,
    };
  }

  List<double?> _roc(
